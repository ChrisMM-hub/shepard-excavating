---
interface Props {
  service?: string;
  location?: string;
}

const formId = '8f2xiLQaiGhgx6T5O7az';
---

<div class="form-card">
  <iframe
    src={`https://api.leadconnectorhq.com/widget/form/${formId}`}
    id={`inline-${formId}`}
    data-layout='{"id":"INLINE"}'
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Shepard Website Estimate Request"
    data-height="undefined"
    data-layout-iframe-id={`inline-${formId}`}
    data-form-id={formId}
    data-cookie-consent="true"
    data-cookie-consent-provider="auto"
    title="Shepard Website Estimate Request"
  ></iframe>
  <p class="form-fine">
    We use your information only to respond to your request. See our <a href="/privacy-policy/">Privacy Policy</a> and <a href="/terms-of-service/">Terms of Service</a>.
  </p>
</div>

<script is:inline src="https://link.msgsndr.com/js/form_embed.js"></script>
<script is:inline>
  // GA4 lead tracking for the embedded HighLevel form. The iframe posts a
  // message on successful submission (event.data is an array carrying the
  // lead payload JSON); standard GTM integrations key off the same signal.
  // Fires gtag('generate_lead') once per page view; gtag only exists in
  // production builds, so dev never records leads.
  (function () {
    if (window.__shepLeadListener) return;
    window.__shepLeadListener = true;
    var fired = false;
    window.addEventListener('message', function (e) {
      if (fired) return;
      var origin = String(e.origin || '');
      if (origin.indexOf('leadconnectorhq.com') === -1 && origin.indexOf('msgsndr.com') === -1) return;
      var payload = '';
      try { payload = JSON.stringify(e.data) || ''; } catch (err) { return; }
      var isSubmit =
        (payload.indexOf('customer_id') !== -1 && payload.indexOf('email') !== -1) ||
        payload.indexOf('msgsndr-booking-complete') !== -1;
      if (!isSubmit) return;
      fired = true;
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'generate_lead', {
          form_id: '8f2xiLQaiGhgx6T5O7az',
          page_location: window.location.href,
        });
      }
    });
  })();
</script>

<style>
  .form-card {
    background: #fff;
    color: var(--ink);
    border: 1px solid rgba(13, 13, 13, 0.08);
    border-top: 4px solid var(--yellow);
    border-radius: var(--r-lg);
    padding: clamp(1rem, 2vw, 1.5rem);
    box-shadow: var(--shadow-lg);
  }

  iframe {
    display: block;
    width: 100%;
    min-height: 820px;
    border: 0;
    border-radius: var(--r);
  }

  .form-fine {
    margin: 0.75rem 0 0;
    font-size: 0.84rem;
    color: var(--slate);
    text-align: center;
  }

  .form-fine a {
    color: var(--red);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 600px) {
    .form-card { padding: 0.75rem; }
    iframe { min-height: 900px; }
  }
</style>
