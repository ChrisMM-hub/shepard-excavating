---
import { featuredServices, moreServices, highlevelWebhook } from '../data/site';

interface Props {
  service?: string; // pre-selects the service dropdown
  location?: string; // accepted for compatibility (town pages pass it); the town field was removed 2026-07-02
}
const { service = '' } = Astro.props;

const services = [...featuredServices, ...moreServices].map((s) => s.title);
---

<div class="form-card">
  <form class="quote-form" novalidate data-webhook={highlevelWebhook}>
    <div class="row">
      <div class="field">
        <label for="qf-name">Name</label>
        <input id="qf-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="qf-phone">Phone <span class="req">*</span></label>
        <input id="qf-phone" name="phone" type="tel" autocomplete="tel" required />
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="qf-email">Email</label>
        <input id="qf-email" name="email" type="email" autocomplete="email" />
      </div>
      <div class="field">
        <label for="qf-service">Service needed</label>
        <select id="qf-service" name="service">
          <option value="">Select a service</option>
          {services.map((s) => (<option value={s} selected={s === service}>{s}</option>))}
          <option value="Something else" selected={service === 'Something else'}>Something else</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="qf-address">Address</label>
      <input id="qf-address" name="address" type="text" autocomplete="street-address" placeholder="Property address or nearest town" />
    </div>
    <div class="field">
      <label for="qf-message">Let us know how we can help.</label>
      <textarea id="qf-message" name="message" rows="4" placeholder="Please enter details about your project or property here."></textarea>
    </div>
    <button type="submit" class="btn btn-primary btn-lg btn-block">Request My Free Estimate</button>
    <p class="form-fine">We answer fast. Your info goes straight to the Shepard family, never sold or shared.</p>
  </form>

  <div class="form-success" hidden>
    <div class="check" aria-hidden="true">✓</div>
    <h3>Thanks, we got it.</h3>
    <p>Your request is in. We will reach out shortly. Need us right now? Call <a href="tel:+12182242754">(218) 224-2754</a>.</p>
  </div>
</div>

<style>
  .form-card { background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: clamp(1.4rem, 3vw, 2rem); box-shadow: var(--shadow-lg); }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
  .field { margin-bottom: 1rem; }
  label { display: block; font-family: var(--font-head); font-weight: 700; font-size: 0.92rem; margin-bottom: 0.35rem; color: var(--ink); }
  .req { color: var(--red); }
  input, select, textarea {
    width: 100%; min-width: 0; font: inherit; font-size: 1rem; padding: 0.75rem 0.85rem;
    border: 1.5px solid var(--line); border-radius: var(--r); background: var(--paper); color: var(--ink);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--red); box-shadow: 0 0 0 3px rgba(194,19,19,0.15); background: #fff; }
  textarea { resize: vertical; }
  .form-fine { font-size: 0.84rem; color: var(--slate); margin-top: 0.8rem; text-align: center; }

  .form-success { text-align: center; padding: 2.5rem 1rem; }
  .form-success .check { width: 64px; height: 64px; margin: 0 auto 1rem; border-radius: 50%; background: var(--yellow); color: var(--ink); font-size: 2rem; font-weight: 800; display: grid; place-items: center; }
  .form-success h3 { font-size: 1.5rem; }
  .form-success p { color: var(--slate); margin-top: 0.5rem; }
  .form-success a { color: var(--red); font-weight: 700; }

  @media (max-width: 460px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  // The form posts to a HighLevel inbound webhook when one is configured (data-webhook),
  // then redirects to /thank-you. With no webhook set it shows the inline success state,
  // so the demo keeps working until HighLevel is connected.
  document.querySelectorAll('.form-card').forEach((card) => {
    const form = card.querySelector('form') as HTMLFormElement | null;
    const success = card.querySelector('.form-success') as HTMLElement | null;
    if (!form) return;
    const field = (n: string) => form.querySelector(`[name="${n}"]`) as HTMLInputElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = field('name')?.value.trim() || '';
      const phone = field('phone')?.value.trim() || '';
      if (!name) { field('name')?.focus(); return; }
      if (!phone) { field('phone')?.focus(); return; }

      const address = field('address')?.value.trim() || '';
      const note = field('message')?.value.trim() || '';
      const payload = {
        name,
        phone,
        email: field('email')?.value.trim() || '',
        service: field('service')?.value || '',
        address,
        // Address rides along inside the message too, so the existing HighLevel
        // notification email shows it without any workflow changes.
        message: address ? `${note}${note ? '\n\n' : ''}Address: ${address}` : note,
        source: 'Website quote form',
        page: window.location.href,
      };

      // GA4 / GTM conversion signal
      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({ event: 'generate_lead', form: 'quote', service: payload.service });

      const webhook = form.dataset.webhook;
      if (webhook) {
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
        try {
          // HighLevel's inbound webhook needs a JSON body (it rejects text/plain)
          // and it answers the CORS preflight with Access-Control-Allow-Origin: *,
          // so a standard application/json POST works cross-origin from the browser.
          await fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.error('Lead webhook error', err);
        }
        window.location.href = '/thank-you';
        return;
      }

      // No webhook configured yet: inline success (demo mode).
      form.hidden = true;
      if (success) success.hidden = false;
      success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>
