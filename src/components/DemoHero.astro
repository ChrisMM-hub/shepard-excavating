---
import { business, homepage } from '../data/site';

const [heroTitleLead, heroTitleValues] = homepage.hero.title.split('\n');
---

<link rel="preload" as="image" href="/video/shepard-hero-mobile-poster.jpg" media="(max-width: 719px)" />
<link rel="preload" as="image" href="/video/shepard-hero-desktop-poster.jpg" media="(min-width: 720px)" />

<section class="hero" aria-label="Introduction" data-hero>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">Family-owned in Laporte since {business.founded}</p>
      <h1>
        <span class="hero-title-lead">{heroTitleLead}</span>
        <span class="hero-title-values">{heroTitleValues}</span>
      </h1>
      <p class="hero-lead">Septic, excavation, aggregate, demolition, and snow services across Northern Minnesota.</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary btn-lg">Get a Free Estimate</a>
        <a href={business.phoneHref} class="hero-phone" aria-label={`Call Shepard Excavating at ${business.phone}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
          <span>
            <span class="phone-label">Call or text</span>
            <strong>{business.phone}</strong>
          </span>
        </a>
      </div>
    </div>
  </div>

  <div class="hero-media">
    <picture class="hero-poster" aria-hidden="true">
      <source media="(max-width: 719px)" srcset="/video/shepard-hero-mobile-poster.jpg" />
      <img
        src="/video/shepard-hero-desktop-poster.jpg"
        alt=""
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    </picture>

    <video
      class="hero-video"
      data-hero-video
      data-mobile-src="/video/shepard-hero-mobile.mp4"
      data-desktop-src="/video/shepard-hero-desktop.mp4"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      aria-hidden="true"
    ></video>

    <div class="hero-overlay" aria-hidden="true"></div>

    <button class="motion-control" type="button" data-motion-control hidden aria-label="Pause background video">
      <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" fill="currentColor"/></svg>
      <span class="sr-only" data-motion-label>Pause video</span>
    </button>
  </div>
</section>

<style>
  .hero {
    --hero-control: rgba(13, 13, 13, 0.68);
    position: relative;
    min-height: clamp(520px, calc(100svh - 250px), 680px);
    display: grid;
    grid-template-columns: minmax(420px, 0.82fr) minmax(0, 1.18fr);
    overflow: hidden;
    background: var(--paper);
  }

  .hero-media {
    position: relative;
    isolation: isolate;
    min-height: inherit;
    overflow: hidden;
    background: var(--ink);
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-poster { z-index: 0; }
  .hero-poster :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-video { z-index: 1; opacity: 0; transition: opacity 0.45s ease; }
  .hero.video-ready .hero-video { opacity: 1; }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(0deg, rgba(5, 5, 5, 0.24) 0%, rgba(5, 5, 5, 0) 38%),
      linear-gradient(90deg, rgba(5, 5, 5, 0.08), rgba(5, 5, 5, 0));
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    padding:
      clamp(3rem, 6vw, 5rem)
      clamp(2rem, 5vw, 5rem);
    background: var(--paper);
  }
  .hero-copy {
    width: 100%;
    max-width: 520px;
  }
  .hero-eyebrow {
    display: block;
    margin-bottom: 0.95rem;
    color: var(--red);
    font-family: var(--font-head);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: none;
    color: var(--ink);
    font-size: clamp(2.65rem, 3.6vw, 3.7rem);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }
  .hero-title-lead,
  .hero-title-values { display: block; }
  .hero-title-values {
    margin-top: 0.45rem;
    color: var(--red-deep);
    font-size: 0.55em;
    line-height: 1.08;
    letter-spacing: 0;
  }

  .hero-lead {
    max-width: 50ch;
    margin-top: 1.15rem;
    color: var(--slate);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.55;
  }

  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.3rem; margin-top: 1.55rem; }
  .hero-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    line-height: 1.15;
  }
  .hero-phone svg {
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    padding: 0.6rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--yellow);
  }
  .phone-label {
    display: block;
    margin-bottom: 0.16rem;
    color: var(--slate);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero-phone strong { font-size: 1rem; }
  .hero-phone:hover strong { color: var(--red-deep); }

  .motion-control {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    background: var(--hero-control);
    color: #fff;
    backdrop-filter: blur(8px);
  }
  .motion-control[hidden] { display: none; }
  .motion-control svg { width: 16px; height: 16px; }
  .motion-control .play-icon { display: none; }
  .motion-control[data-paused='true'] .pause-icon { display: none; }
  .motion-control[data-paused='true'] .play-icon { display: block; }
  .motion-control:hover { background: rgba(13, 13, 13, 0.9); }

  @media (max-width: 1023px) {
    .hero {
      min-height: clamp(590px, calc(100svh - 170px), 760px);
      display: flex;
      align-items: flex-end;
      background: var(--ink);
    }
    .hero-media {
      position: absolute;
      inset: 0;
      min-height: 0;
    }
    .hero-overlay {
      background:
        linear-gradient(0deg, rgba(5, 5, 5, 0.34) 0%, rgba(5, 5, 5, 0.03) 68%),
        linear-gradient(90deg, rgba(5, 5, 5, 0.12), rgba(5, 5, 5, 0.02));
    }
    .hero-inner {
      width: 100%;
      padding: 4.5rem var(--gutter) 1.4rem;
      background: transparent;
    }
    .hero-copy {
      max-width: 600px;
      padding: clamp(1.45rem, 3.6vw, 2rem);
      border-left: 6px solid var(--red);
      background: rgba(245, 245, 245, 0.95);
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(10px);
    }
    .motion-control { top: 1rem; right: var(--gutter); bottom: auto; }
  }

  @media (max-width: 719px) {
    .hero {
      min-height: clamp(650px, calc(100svh - 145px), 790px);
    }
    .hero-inner { padding-block: 5rem 1.2rem; }
    .hero-copy { max-width: none; padding: 1.3rem; border-left-width: 5px; }
    .hero h1 { font-size: clamp(2.35rem, 11vw, 3.05rem); }
    .hero-title-values { margin-top: 0.35rem; font-size: 0.58em; }
    .hero-lead { max-width: 36ch; margin-top: 0.9rem; font-size: 0.98rem; }
    .hero-actions { display: grid; grid-template-columns: 1fr; gap: 0.8rem; margin-top: 1.2rem; }
    .hero-actions .btn { width: 100%; }
    .hero-phone { justify-self: center; }
    .motion-control { top: 1rem; right: var(--gutter); bottom: auto; width: 42px; height: 42px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { transition: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = hero?.querySelector<HTMLVideoElement>('[data-hero-video]');
  const control = hero?.querySelector<HTMLButtonElement>('[data-motion-control]');
  const label = control?.querySelector<HTMLElement>('[data-motion-label]');
  const narrowScreen = window.matchMedia('(max-width: 719px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let userPaused = false;

  const setControlState = (paused: boolean) => {
    if (!control || !label) return;
    control.dataset.paused = String(paused);
    control.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
    label.textContent = paused ? 'Play video' : 'Pause video';
  };

  const loadBestVideo = (autoplay = true) => {
    if (!video) return;
    const source = narrowScreen.matches ? video.dataset.mobileSrc : video.dataset.desktopSrc;
    if (!source) return;
    if (video.dataset.currentSrc !== source) {
      hero?.classList.remove('video-ready');
      video.dataset.currentSrc = source;
      video.src = source;
      video.load();
    }
    if (autoplay) {
      video.play().catch(() => setControlState(true));
    }
  };

  if (video && control) {
    control.hidden = false;
    setControlState(reducedMotion.matches);
    if (!reducedMotion.matches) loadBestVideo(true);

    video.addEventListener('loadeddata', () => hero?.classList.add('video-ready'));
    video.addEventListener('playing', () => setControlState(false));
    video.addEventListener('pause', () => setControlState(true));
    narrowScreen.addEventListener('change', () => {
      if (reducedMotion.matches && !video.dataset.currentSrc) return;
      loadBestVideo(!userPaused && !video.paused);
    });
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) video.pause();
      else loadBestVideo(!userPaused);
    });

    control.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        loadBestVideo(false);
        video.play().catch(() => setControlState(true));
      }
      else {
        userPaused = true;
        video.pause();
      }
    });
  }
</script>
