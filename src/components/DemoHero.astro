---
import { business, homepage } from '../data/site';
---

<link rel="preload" as="image" href="/video/shepard-hero-mobile-poster.jpg" media="(max-width: 719px)" />
<link rel="preload" as="image" href="/video/shepard-hero-desktop-poster.jpg" media="(min-width: 720px)" />

<section class="hero" aria-label="Introduction" data-hero>
  <picture class="hero-poster" aria-hidden="true">
    <source media="(max-width: 719px)" srcset="/video/shepard-hero-mobile-poster.jpg" />
    <img
      src="/video/shepard-hero-desktop-poster.jpg"
      alt=""
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </picture>

  <video
    class="hero-video"
    data-hero-video
    data-mobile-src="/video/shepard-hero-mobile.mp4"
    data-desktop-src="/video/shepard-hero-desktop.mp4"
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    aria-hidden="true"
  ></video>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">Family-owned in Laporte since {business.founded}</p>
      <h1>{homepage.hero.title.split('\n').map((line, i) => (
        <Fragment>{i > 0 && <br />}{line}</Fragment>
      ))}</h1>
      <p class="hero-lead">Septic, excavation, aggregate, demolition, and snow services across Northern Minnesota.</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-yellow btn-lg">Get a Free Estimate</a>
        <a href={business.phoneHref} class="btn btn-outline btn-lg" aria-label={`Call Shepard Excavating at ${business.phone}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
          {business.phone}
        </a>
      </div>
      <ul class="hero-trust" aria-label="Why choose Shepard Excavating">
        <li>One local crew</li>
        <li>Serving Northern Minnesota</li>
        <li>Free estimates</li>
      </ul>
    </div>
  </div>

  <button class="motion-control" type="button" data-motion-control hidden aria-label="Pause background video">
    <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
    <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" fill="currentColor"/></svg>
    <span data-motion-label>Pause video</span>
  </button>
</section>

<style>
  .hero {
    --hero-scrim: linear-gradient(90deg, rgba(5, 5, 5, 0.88) 0%, rgba(5, 5, 5, 0.6) 46%, rgba(5, 5, 5, 0.18) 100%);
    --hero-floor: linear-gradient(0deg, rgba(5, 5, 5, 0.58) 0%, rgba(5, 5, 5, 0) 45%);
    --hero-control: rgba(13, 13, 13, 0.68);
    position: relative;
    isolation: isolate;
    min-height: clamp(440px, calc(100svh - 230px), 680px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--ink);
  }

  .hero-poster,
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-poster { z-index: -4; }
  .hero-poster :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-video { z-index: -3; opacity: 0; transition: opacity 0.45s ease; }
  .hero.video-ready .hero-video { opacity: 1; }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--hero-floor), var(--hero-scrim);
  }

  .hero-inner { color: #fff; padding-block: clamp(3.5rem, 8vw, 6rem); }
  .hero-copy { width: min(680px, 63%); }
  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
    color: var(--yellow);
    font-family: var(--font-head);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .hero-eyebrow::before { content: ''; width: 32px; height: 3px; flex: 0 0 auto; border-radius: 2px; background: var(--yellow); }

  .hero h1 {
    max-width: 12ch;
    color: #fff;
    font-size: clamp(2.65rem, 5.3vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-shadow: 0 3px 22px rgba(0, 0, 0, 0.45);
  }

  .hero-lead {
    max-width: 55ch;
    margin-top: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.55;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.65rem; }
  .hero-actions .btn-outline { background: rgba(13, 13, 13, 0.3); backdrop-filter: blur(5px); }

  .hero-trust { display: flex; flex-wrap: wrap; gap: 0.65rem 1.2rem; margin-top: 1.35rem; }
  .hero-trust li {
    position: relative;
    padding-left: 0.9rem;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }
  .hero-trust li::before { content: ''; position: absolute; top: 0.48em; left: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--yellow); }

  .motion-control {
    position: absolute;
    right: max(1rem, calc((100vw - var(--container)) / 2 + var(--gutter)));
    bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: var(--r);
    background: var(--hero-control);
    color: #fff;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    backdrop-filter: blur(8px);
  }
  .motion-control[hidden] { display: none; }
  .motion-control svg { width: 16px; height: 16px; }
  .motion-control .play-icon { display: none; }
  .motion-control[data-paused='true'] .pause-icon { display: none; }
  .motion-control[data-paused='true'] .play-icon { display: block; }
  .motion-control:hover { background: rgba(13, 13, 13, 0.9); }

  @media (max-width: 719px) {
    .hero {
      min-height: clamp(520px, calc(100svh - 170px), 700px);
      align-items: flex-end;
    }
    .hero-overlay {
      background:
        linear-gradient(0deg, rgba(5, 5, 5, 0.94) 0%, rgba(5, 5, 5, 0.66) 47%, rgba(5, 5, 5, 0.1) 78%),
        linear-gradient(90deg, rgba(5, 5, 5, 0.3), rgba(5, 5, 5, 0.05));
    }
    .hero-inner { padding-block: 4.5rem 5.5rem; }
    .hero-copy { width: 100%; }
    .hero h1 { max-width: 11ch; font-size: clamp(2.35rem, 12vw, 3.45rem); }
    .hero-lead { max-width: 34ch; margin-top: 1rem; font-size: 1rem; }
    .hero-actions { display: grid; grid-template-columns: 1fr; max-width: 330px; margin-top: 1.35rem; }
    .hero-actions .btn { width: 100%; }
    .hero-trust { gap: 0.5rem 0.9rem; margin-top: 1.15rem; }
    .hero-trust li { font-size: 0.7rem; }
    .motion-control { right: var(--gutter); bottom: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video { transition: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = hero?.querySelector<HTMLVideoElement>('[data-hero-video]');
  const control = hero?.querySelector<HTMLButtonElement>('[data-motion-control]');
  const label = control?.querySelector<HTMLElement>('[data-motion-label]');
  const narrowScreen = window.matchMedia('(max-width: 719px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let userPaused = false;

  const setControlState = (paused: boolean) => {
    if (!control || !label) return;
    control.dataset.paused = String(paused);
    control.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
    label.textContent = paused ? 'Play video' : 'Pause video';
  };

  const loadBestVideo = (autoplay = true) => {
    if (!video) return;
    const source = narrowScreen.matches ? video.dataset.mobileSrc : video.dataset.desktopSrc;
    if (!source) return;
    if (video.dataset.currentSrc !== source) {
      hero?.classList.remove('video-ready');
      video.dataset.currentSrc = source;
      video.src = source;
      video.load();
    }
    if (autoplay) {
      video.play().catch(() => setControlState(true));
    }
  };

  if (video && control) {
    control.hidden = false;
    setControlState(reducedMotion.matches);
    if (!reducedMotion.matches) loadBestVideo(true);

    video.addEventListener('loadeddata', () => hero?.classList.add('video-ready'));
    video.addEventListener('playing', () => setControlState(false));
    video.addEventListener('pause', () => setControlState(true));
    narrowScreen.addEventListener('change', () => {
      if (reducedMotion.matches && !video.dataset.currentSrc) return;
      loadBestVideo(!userPaused && !video.paused);
    });
    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) video.pause();
      else loadBestVideo(!userPaused);
    });

    control.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        loadBestVideo(false);
        video.play().catch(() => setControlState(true));
      }
      else {
        userPaused = true;
        video.pause();
      }
    });
  }
</script>
