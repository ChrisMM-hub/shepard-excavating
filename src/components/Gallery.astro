---
import { Image } from 'astro:assets';
import gFleet from '../assets/photos/hero-fleet.jpg';
import gSeptic from '../assets/photos/gal-septic.jpg';
import gExcav from '../assets/photos/svc-excavating.jpg';
import gLand from '../assets/photos/gal-landclearing.jpg';
import gDemo from '../assets/photos/svc-demolition.jpg';
import gAgg from '../assets/photos/gal-aggregate.jpg';

// Explicit bento placement so the grid always tiles with no holes.
const shots = [
  { img: gFleet, alt: 'The Shepard Excavating truck fleet lined up', cls: 'g-a' },
  { img: gSeptic, alt: 'New septic drain field installation', cls: 'g-b' },
  { img: gExcav, alt: 'Excavator and loader during site work', cls: 'g-c' },
  { img: gLand, alt: 'Cleared lake lot ready for building', cls: 'g-d' },
  { img: gDemo, alt: 'Excavator demolishing an old cabin next to a roll-off dumpster', cls: 'g-e' },
  { img: gAgg, alt: 'Loader and screened gravel at the pit', cls: 'g-f' },
];
---

<section class="section section--stone" id="work" aria-labelledby="work-h">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">On the job</p>
      <h2 id="work-h">Real work, real equipment, real Northern Minnesota dirt</h2>
    </div>
    <div class="gal">
      {shots.map((s) => (
        <figure class={'gal-item ' + s.cls}>
          <Image src={s.img} alt={s.alt} widths={[400, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" quality={72} />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gal {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 210px);
    gap: 1rem;
  }
  .gal-item { position: relative; overflow: hidden; border-radius: var(--r-lg); box-shadow: var(--shadow-sm); }
  .gal-item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .gal-item:hover :global(img) { transform: scale(1.07); }

  /* desktop bento: 4 cols x 3 rows, fully tiled */
  .g-a { grid-column: 1 / 3; grid-row: 1 / 3; }
  .g-b { grid-column: 3 / 4; grid-row: 1 / 2; }
  .g-c { grid-column: 4 / 5; grid-row: 1 / 2; }
  .g-d { grid-column: 3 / 5; grid-row: 2 / 3; }
  .g-e { grid-column: 1 / 3; grid-row: 3 / 4; }
  .g-f { grid-column: 3 / 5; grid-row: 3 / 4; }

  @media (max-width: 800px) {
    .gal { grid-template-columns: repeat(2, 1fr); grid-template-rows: none; grid-auto-rows: 165px; }
    .gal-item { grid-column: auto !important; grid-row: auto !important; }
    .g-a { grid-column: 1 / 3 !important; grid-row: span 2 !important; }
  }
  @media (max-width: 460px) {
    .gal { grid-template-columns: 1fr; grid-auto-rows: 200px; }
    .g-a { grid-column: 1 / 2 !important; grid-row: span 1 !important; }
  }
</style>
