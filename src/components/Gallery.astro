---
import { Image } from 'astro:assets';
import gFleet from '../assets/photos/hero-fleet.jpg';
import gSeptic from '../assets/photos/gal-septic.jpg';
import gExcav from '../assets/photos/svc-excavating.jpg';
import gLand from '../assets/photos/gal-landclearing.jpg';
import gDemo from '../assets/photos/svc-demolition.jpg';
import gAgg from '../assets/photos/gal-aggregate.jpg';

// A curated, captioned strip (CSS scroll-snap) instead of a stack of photos.
const shots = [
  { img: gFleet, cap: 'Our fleet, ready to roll', alt: 'The Shepard Excavating truck fleet lined up' },
  { img: gSeptic, cap: 'A fresh septic drain field', alt: 'New septic drain field installation' },
  { img: gExcav, cap: 'Site prep and grading', alt: 'Excavator and loader during site work' },
  { img: gLand, cap: 'Clearing a lake lot', alt: 'A cleared wooded lot ready for building' },
  { img: gDemo, cap: 'Cabin teardown and haul-off', alt: 'Excavator demolishing an old cabin beside a roll-off dumpster' },
  { img: gAgg, cap: 'Screened gravel from our pit', alt: 'Loader and a pile of screened gravel at the pit' },
];
---

<section class="section section--stone" id="work" aria-labelledby="work-h">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">On the job</p>
      <h2 id="work-h">Real work, real equipment, real Northern Minnesota dirt</h2>
      <p class="lead">A look at recent septic, site work, clearing, and gravel jobs around the lakes.</p>
    </div>
  </div>
  <div class="gal-strip" role="list" aria-label="Recent project photos">
    {shots.map((s, i) => (
      <figure class="gal-card" role="listitem">
        <Image src={s.img} alt={s.alt} widths={[360, 720]} sizes="(max-width: 760px) 80vw, 360px" quality={72} loading={i < 2 ? 'eager' : 'lazy'} />
        <figcaption>{s.cap}</figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .gal-strip {
    display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
    padding: 0 var(--gutter) 0.5rem; max-width: var(--container); margin-inline: auto;
  }
  .gal-strip::-webkit-scrollbar { display: none; }
  .gal-card {
    position: relative; flex: 0 0 min(80%, 360px); scroll-snap-align: start;
    aspect-ratio: 4 / 3; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); margin: 0;
  }
  .gal-card :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gal-card figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 1.4rem 1.1rem 0.9rem;
    color: #fff; font-family: var(--font-head); font-weight: 700; font-size: 1rem; letter-spacing: 0.01em;
    background: linear-gradient(180deg, rgba(20,18,16,0) 0%, rgba(20,18,16,0.82) 100%);
  }
  @media (min-width: 1040px) { .gal-card { flex-basis: 30%; } }
</style>
