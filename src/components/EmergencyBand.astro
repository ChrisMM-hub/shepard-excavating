---
import { business } from '../data/site';
---

<section class="emergency" id="emergency" aria-labelledby="emer-h">
  <div class="container emer-inner">
    <div class="emer-text">
      <span class="pulse" aria-hidden="true"></span>
      <div>
        <h2 id="emer-h">Septic emergency? Frozen line or backup?</h2>
        <p>It will not wait for business hours, and neither do we. Call now and we will get a truck headed your way.</p>
      </div>
    </div>
    <a href={business.phoneHref} class="btn btn-lg call">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
      {business.phone}
    </a>
  </div>
</section>

<style>
  .emergency { background: var(--red); color: #fff; }
  .emer-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.6rem; padding-block: clamp(1.8rem, 3.5vw, 2.6rem); flex-wrap: wrap; }
  .emer-text { display: flex; align-items: center; gap: 1.1rem; }
  .emergency h2 { color: #fff; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .emer-text p { color: #ffe3df; margin-top: 0.3rem; max-width: 52ch; }
  .pulse { width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0 rgba(255,255,255,0.7); animation: pulse 1.8s infinite; flex-shrink: 0; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(255,255,255,0.6); } 70% { box-shadow: 0 0 0 16px rgba(255,255,255,0); } 100% { box-shadow: 0 0 0 0 rgba(255,255,255,0); } }
  .call { background: #fff; color: var(--red-deep); border-color: #fff; font-size: 1.25rem; }
  .call svg { width: 1.2em; height: 1.2em; }
  .call:hover { background: var(--ink); color: #fff; border-color: var(--ink); transform: translateY(-2px); }
  @media (max-width: 720px) { .call { width: 100%; } }
</style>
