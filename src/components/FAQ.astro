---
import { faqs, business } from '../data/site';
---

<section class="section" id="faq" aria-labelledby="faq-h">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow" style="justify-content:center;">Good questions</p>
      <h2 id="faq-h">Frequently asked questions</h2>
    </div>

    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item" name="shepard-faq">
          <summary>
            <span class="faq-q">{f.q}</span>
            <span class="faq-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>

    <p class="faq-foot">
      Still have a question? <a href={business.phoneHref}>Call {business.phone}</a> or
      <a href="#contact">send us a message</a>.
    </p>
  </div>
</section>

<style>
  .faq-list { max-width: 820px; margin: 0 auto; }
  .faq-item { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); margin-bottom: 0.85rem; overflow: hidden; transition: box-shadow 0.16s; }
  .faq-item[open] { box-shadow: var(--shadow-sm); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; padding: 1.15rem 1.35rem; }
  summary::-webkit-details-marker { display: none; }
  .faq-q { font-family: var(--font-head); font-weight: 700; font-size: 1.12rem; line-height: 1.25; }
  .faq-ic { flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: var(--stone); color: var(--ink); transition: transform 0.22s ease, background 0.16s; }
  .faq-ic svg { width: 18px; height: 18px; }
  .faq-item[open] .faq-ic { transform: rotate(180deg); background: var(--yellow); }
  summary:hover .faq-q { color: var(--orange-deep); }
  .faq-a { padding: 0 1.35rem 1.25rem; }
  .faq-a p { color: var(--slate); max-width: 68ch; }
  .faq-foot { text-align: center; margin-top: 1.8rem; color: var(--slate); font-family: var(--font-head); font-weight: 600; }
  .faq-foot a { color: var(--orange-deep); }
  .faq-foot a:hover { color: var(--ink); }
</style>
