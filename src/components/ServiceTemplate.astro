---
import { Image } from 'astro:assets';
import QuoteForm from './QuoteForm.astro';
import { img } from '../lib/images';
import { business, towns } from '../data/site';
import { serviceBySlug, type Service } from '../data/services';

interface Props { service: Service; }
const { service } = Astro.props;
const related = service.related.map((s) => serviceBySlug[s]).filter(Boolean);
const hero = img(service.heroImage);
---

<!-- Hero -->
<section class="svc-hero" aria-label={service.navLabel}>
  {service.heroUpload ? (
    <img src={service.heroUpload} alt={service.navLabel + ' by Shepard Excavating'} class="svc-hero-bg" loading="eager" fetchpriority="high" />
  ) : (
    <Image src={hero} alt={service.navLabel + ' by Shepard Excavating'} class="svc-hero-bg" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={76} />
  )}
  <div class="svc-hero-overlay"></div>
  <div class="container svc-hero-inner">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{service.navLabel}</span></nav>
    <p class="eyebrow eyebrow--light">{service.bucket}</p>
    <h1>{service.h1}</h1>
    <p class="svc-lead">{service.lead}</p>
    <div class="svc-cta">
      {service.emphasizePhone ? (
        <>
          <a href={business.phoneHref} class="btn btn-red btn-lg">Call {business.phone}</a>
          <a href="#quote" class="btn btn-outline btn-lg">Request a callback</a>
        </>
      ) : (
        <>
          <a href="#quote" class="btn btn-primary btn-lg">Get a Free Estimate</a>
          <a href={business.phoneHref} class="btn btn-outline btn-lg">Call {business.phone}</a>
        </>
      )}
    </div>
  </div>
</section>

<!-- Details -->
<section class="section" id="details">
  <div class="container detail-grid">
    <div class="detail-main">
      <h2>{service.includedHeading}</h2>
      <ul class="ticks two-col">
        {service.included.map((i) => (<li>{i}</li>))}
      </ul>

      {service.factors && service.factors.length > 0 && (
        <div class="detail-block">
          <h3>What affects your price</h3>
          <p class="muted">We do not believe in surprise bills. Here is what moves the number up or down, and we will walk you through it before any work starts.</p>
          <ul class="ticks">
            {service.factors.map((f) => (<li>{f}</li>))}
          </ul>
        </div>
      )}

      {(service.timeline || service.expect) && (
        <div class="detail-block">
          <h3>What to expect</h3>
          {service.timeline && <p>{service.timeline}</p>}
          {service.expect && <p>{service.expect}</p>}
        </div>
      )}
    </div>

    <aside class="detail-aside">
      <div class="aside-card">
        <h3>Get a free estimate</h3>
        <p>Tell us about your {service.navLabel.toLowerCase()} job and we will get you a fair, no-pressure price.</p>
        <a href="#quote" class="btn btn-primary btn-block">Request an estimate</a>
        <a href={business.phoneHref} class="btn btn-ghost btn-block">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
          {business.phone}
        </a>
        <p class="aside-note">{business.hours}</p>
      </div>
    </aside>
  </div>
</section>

<!-- Photos -->
{service.gallery && service.gallery.length > 0 && (
  <section class="section section--stone">
    <div class="container">
      <div class="svc-gallery" data-count={service.gallery.length}>
        {service.gallery.map((g) => (
          <figure><Image src={img(g)} alt={service.navLabel + ' work by Shepard Excavating'} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 360px" quality={74} /></figure>
        ))}
      </div>
    </div>
  </section>
)}

<!-- FAQ -->
{service.faqs && service.faqs.length > 0 && (
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Good questions</p><h2>{service.navLabel} FAQs</h2></div>
      <div class="faq-list">
        {service.faqs.map((f) => (
          <details class="faq-item" name="svc-faq">
            <summary><span class="faq-q">{f.q}</span><span class="faq-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></summary>
            <div class="faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Related + service area -->
<section class="section section--stone">
  <div class="container">
    {related.length > 0 && (
      <div class="related">
        <h2>Related services</h2>
        <div class="related-grid">
          {related.map((r) => (
            <a class="related-card" href={'/' + r.slug}>
              <Image src={img(r.heroImage)} alt={r.navLabel} widths={[300, 600]} sizes="280px" quality={70} />
              <span class="rc-label" set:html={r.navLabel + '&nbsp;<span class="arr" aria-hidden="true">&rarr;</span>'} />
            </a>
          ))}
        </div>
      </div>
    )}
    <p class="area-line">Serving {towns.slice(0, -1).join(', ')}, and {towns[towns.length - 1]}, plus the surrounding lake country.</p>
  </div>
</section>

<!-- Quote CTA -->
<section class="section section--dark" id="quote" aria-labelledby="quote-h">
  <div class="container contact-grid">
    <div class="contact-info">
      <p class="eyebrow">Get a free estimate</p>
      <h2 id="quote-h">Let's talk about your {service.navLabel.toLowerCase()}</h2>
      <p class="lead">Fill out the form or call and talk to a real person. Fair price, no runaround.</p>
      <p class="contact-phone"><a href={business.phoneHref}>{business.phone}</a></p>
      <p class="contact-sub">{business.address.street}, {business.address.city}, {business.address.region} {business.address.zip}<br />{business.hours}</p>
    </div>
    <QuoteForm service={service.navLabel} />
  </div>
</section>

<style>
  .svc-hero { position: relative; isolation: isolate; display: flex; align-items: center; min-height: clamp(360px, 52vh, 520px); }
  .svc-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .svc-hero-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(20,18,16,0.86) 0%, rgba(20,18,16,0.5) 60%, rgba(20,18,16,0.25) 100%), linear-gradient(0deg, rgba(20,18,16,0.7), rgba(20,18,16,0.2)); }
  .svc-hero-inner { color: #fff; padding-block: clamp(2rem, 5vw, 3.5rem); }
  .crumbs { display: flex; gap: 0.5rem; font-family: var(--font-head); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; color: #cfccc2; margin-bottom: 0.8rem; }
  .crumbs a { color: var(--yellow); }
  .eyebrow--light { color: var(--yellow); }
  .eyebrow--light::before { background: var(--yellow); }
  .svc-hero h1 { color: #fff; font-size: clamp(2rem, 4.2vw, 3.2rem); margin: 0.5rem 0 0; max-width: 20ch; text-shadow: 0 2px 20px rgba(0,0,0,0.35); }
  .svc-lead { max-width: 54ch; margin-top: 1rem; font-size: clamp(1.05rem, 1.5vw, 1.25rem); color: #ece9e2; }
  .svc-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }

  .detail-grid { display: grid; grid-template-columns: 1fr 340px; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  .detail-main h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .detail-block { margin-top: 2.2rem; }
  .detail-block h3 { font-size: 1.3rem; margin-bottom: 0.6rem; }
  .detail-block p { color: var(--slate); margin-bottom: 0.8rem; max-width: 64ch; }
  .muted { color: var(--slate); }
  .ticks { display: grid; gap: 0.6rem; margin-top: 1rem; }
  .ticks.two-col { grid-template-columns: 1fr 1fr; gap: 0.6rem 1.6rem; }
  .ticks li { position: relative; padding-left: 1.6rem; color: var(--ink); line-height: 1.4; }
  .ticks li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 11px; height: 11px; border-radius: 2px; background: var(--yellow); }

  .detail-aside { position: sticky; top: calc(var(--header-h) + 1.2rem); }
  .aside-card { background: var(--stone); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.5rem; }
  .aside-card h3 { font-size: 1.3rem; }
  .aside-card > p { color: var(--slate); margin: 0.5rem 0 1.1rem; }
  .aside-card .btn { margin-bottom: 0.6rem; }
  .aside-note { font-family: var(--font-head); font-weight: 600; font-size: 0.84rem; color: var(--slate); margin-top: 0.4rem; }

  .svc-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .svc-gallery[data-count='2'] { grid-template-columns: repeat(2, 1fr); max-width: 760px; margin: 0 auto; }
  .svc-gallery figure { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); aspect-ratio: 4 / 3; }
  .svc-gallery :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .faq-list { max-width: 820px; margin: 0 auto; }
  .faq-item { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); margin-bottom: 0.85rem; overflow: hidden; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; padding: 1.1rem 1.35rem; }
  summary::-webkit-details-marker { display: none; }
  .faq-q { font-family: var(--font-head); font-weight: 700; font-size: 1.08rem; }
  .faq-ic { flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: var(--stone); color: var(--ink); transition: transform 0.22s, background 0.16s; }
  .faq-ic svg { width: 18px; height: 18px; }
  .faq-item[open] .faq-ic { transform: rotate(180deg); background: var(--yellow); }
  .faq-a { padding: 0 1.35rem 1.25rem; }
  .faq-a p { color: var(--slate); max-width: 68ch; }

  .related h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1.2rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .related-card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; transition: transform 0.16s, box-shadow 0.16s; }
  .related-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .related-card :global(img) { width: 100%; height: 150px; object-fit: cover; }
  .related-card .rc-label { padding: 0.9rem 1rem; font-family: var(--font-head); font-weight: 700; color: var(--ink); }
  .related-card :global(.arr) { color: var(--red); }
  .area-line { margin-top: 2rem; font-family: var(--font-head); font-weight: 600; color: var(--slate); text-align: center; }

  .contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact-phone { margin-top: 1.2rem; }
  .contact-phone a { font-family: var(--font-head); font-weight: 800; font-size: 1.8rem; color: var(--yellow); }
  .contact-sub { color: #cfccc2; margin-top: 0.6rem; line-height: 1.5; }

  @media (max-width: 900px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { position: static; }
    .ticks.two-col { grid-template-columns: 1fr; }
    .svc-gallery { grid-template-columns: repeat(2, 1fr); }
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) { .svc-gallery, .svc-gallery[data-count='2'] { grid-template-columns: 1fr; } }
</style>
