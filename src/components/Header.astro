---
import { Image } from 'astro:assets';
import logo from '../assets/logo-shepard.png';
import { business } from '../data/site';

// Bucketed navigation (the IA from the design-direction doc).
// In the prototype, links resolve to on-page anchors so nothing 404s during the demo.
const nav = [
  {
    label: 'Septic',
    href: '/septic-pumping',
    items: [
      ['Septic Pumping & Maintenance', '/septic-pumping'],
      ['Septic System Installation', '/septic-system'],
      ['Septic Emergency', '/septic-emergency'],
      ['Septic Education', '/septic-education'],
    ],
  },
  {
    label: 'Site Work',
    href: '/excavating',
    items: [
      ['Excavating', '/excavating'],
      ['Land Clearing', '/land-clearing'],
      ['Demolition', '/demolition'],
    ],
  },
  {
    label: 'Materials & Rentals',
    href: '/aggregate',
    items: [
      ['Material Calculator', '/material-calculator'],
      ['Sand, Gravel & Aggregate', '/aggregate'],
      ['Roll-Off Dumpsters', '/roll-off-boxes'],
    ],
  },
  {
    label: 'Seasonal',
    href: '/snow-removal',
    items: [
      ['Snow Removal', '/snow-removal'],
      ['Fisher Snowplow Dealer', '/fisher-snowplows'],
    ],
  },
  {
    label: 'About',
    href: '/about',
    items: [
      ['About Shepard', '/about'],
      ['Service Area', '/#service-area'],
      ['Project Gallery', '/gallery'],
      ['Reviews', '/#reviews'],
      ['Contact', '/contact'],
    ],
  },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header" id="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={business.shortName + ' home'}>
      <Image src={logo} alt={business.name} width={240} height={104} quality={88} loading="eager" />
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {nav.map((g) => {
          const act = g.href === here || g.items.some((it) => it[1] === here);
          return (
            <li class={g.items.length ? 'has-menu' : ''}>
              <a href={g.href} class={act ? 'nav-active' : ''} aria-current={act ? 'page' : undefined}>{g.label}{g.items.length ? <span class="caret" aria-hidden="true">▾</span> : null}</a>
              {g.items.length > 0 && (
                <ul class="submenu">
                  {g.items.map(([label, href]) => (
                    <li><a href={href} class={href === here ? 'sub-active' : ''}>{label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="actions">
      <a href={business.phoneHref} class="phone">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
        <span>{business.phone}</span>
      </a>
      <a href="/#contact" class="btn btn-primary quote-btn">Get a Quote</a>
      <button class="menu-toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- mobile panel -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      {nav.map((g) => (
        <li><a href={g.href} class="m-top">{g.label}</a>
          {g.items.length > 0 && (
            <ul>{g.items.map(([label, href]) => (<li><a href={href}>{label}</a></li>))}</ul>
          )}
        </li>
      ))}
    </ul>
    <div class="mobile-cta">
      <a href={business.phoneHref} class="btn btn-dark btn-block">Call {business.phone}</a>
      <a href="/#contact" class="btn btn-primary btn-block">Get a Free Estimate</a>
    </div>
  </div>
</header>
<div id="top"></div>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.2s ease;
  }
  .site-header.scrolled { box-shadow: 0 6px 24px -14px rgba(20,18,16,0.4); }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: var(--header-h); }
  .brand { flex-shrink: 0; display: flex; align-items: center; }
  .brand img { height: 50px; width: auto; }

  .nav { margin-left: auto; }
  .nav > ul { display: flex; align-items: center; gap: 0.35rem; }
  .nav > ul > li { position: relative; }
  .nav > ul > li > a {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-family: var(--font-head); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.03em; font-size: 0.94rem; color: var(--ink);
    padding: 0.6rem 0.7rem; border-radius: var(--r);
  }
  .nav > ul > li > a:hover { color: var(--orange-deep); background: var(--stone); }
  .nav > ul > li > a.nav-active { color: var(--orange-deep); }
  .submenu li a.sub-active { background: var(--stone); color: var(--orange-deep); }
  .caret { font-size: 0.7em; opacity: 0.7; }

  .submenu {
    position: absolute; top: 100%; left: 0; min-width: 248px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow); padding: 0.4rem;
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
  }
  .has-menu:hover .submenu, .has-menu:focus-within .submenu { opacity: 1; visibility: visible; transform: translateY(0); }
  .submenu li a {
    display: block; padding: 0.6rem 0.7rem; border-radius: var(--r);
    font-weight: 600; font-size: 0.98rem; color: var(--ink);
  }
  .submenu li a:hover { background: var(--stone); color: var(--orange-deep); }

  .actions { display: flex; align-items: center; gap: 0.9rem; flex-shrink: 0; }
  .phone { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-head); font-weight: 800; font-size: 1.12rem; color: var(--ink); }
  .phone svg { width: 20px; height: 20px; color: var(--orange-deep); }
  .phone:hover { color: var(--orange-deep); }

  .menu-toggle { display: none; flex-direction: column; gap: 5px; background: none; border: 0; padding: 0.4rem; }
  .menu-toggle span { width: 26px; height: 3px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* Open menu is a fixed overlay that scrolls on its own, below the sticky header.
     overscroll-behavior + body lock keep the page behind from scrolling. */
  .mobile-menu {
    position: fixed; top: var(--header-h); left: 0; right: 0; bottom: 0;
    overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain;
    border-top: 1px solid var(--line); padding: 1rem var(--gutter) 2.5rem; background: #fff; z-index: 99;
  }
  :global(body.nav-open) { overflow: hidden; }
  .mobile-menu > ul > li { border-bottom: 1px solid var(--line); }
  .mobile-menu .m-top { display: block; font-family: var(--font-head); font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em; padding: 0.85rem 0; font-size: 1.05rem; }
  .mobile-menu ul ul { padding: 0 0 0.6rem 0.6rem; }
  .mobile-menu ul ul a { display: block; padding: 0.4rem 0; color: var(--slate); font-weight: 600; }
  .mobile-cta { display: grid; gap: 0.7rem; margin-top: 1.2rem; }

  @media (max-width: 1080px) {
    .nav, .quote-btn { display: none; }
    .menu-toggle { display: flex; }
    .actions { margin-left: auto; }
  }
  @media (max-width: 520px) {
    .phone span { display: none; }
    .brand img { height: 42px; }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const header = document.getElementById('site-header');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    document.body.classList.toggle('nav-open', !open); // lock background scroll while open
  });

  // close mobile menu on link click
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.hidden = true;
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('nav-open');
    })
  );

  // header shadow on scroll
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
