---
import { reviews } from '../data/site';
// NOTE: reviews in src/data/site.ts are PLACEHOLDER copy.
// Replace with live Google Business Profile reviews before launch.
---

<section class="section section--stone" id="reviews" aria-labelledby="rev-h">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow" style="justify-content:center;">Word around the lakes</p>
      <h2 id="rev-h">Neighbors who called Shepard</h2>
    </div>
    <ul class="rev-grid">
      {reviews.map((r) => (
        <li class="rev-card">
          <div class="stars" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 15l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8L10 1.6Z" fill="currentColor"/></svg>))}
          </div>
          <blockquote>{r.quote}</blockquote>
          <p class="rev-by"><strong>{r.name}</strong><span>{r.town}</span></p>
        </li>
      ))}
    </ul>
    <p class="rev-foot">Reviews pulled from Google. <a href="#contact">Read more or leave one →</a></p>
  </div>
</section>

<style>
  .rev-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .rev-card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.6rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 0.9rem; }
  .stars { display: flex; gap: 2px; color: var(--orange); }
  .stars svg { width: 20px; height: 20px; }
  blockquote { font-size: 1.06rem; line-height: 1.55; color: var(--ink); flex: 1; }
  .rev-by { display: flex; flex-direction: column; }
  .rev-by strong { font-family: var(--font-head); font-weight: 700; font-size: 1.04rem; }
  .rev-by span { color: var(--slate); font-size: 0.9rem; }
  .rev-foot { text-align: center; margin-top: 1.6rem; color: var(--slate); font-family: var(--font-head); font-weight: 600; }
  .rev-foot a { color: var(--orange-deep); }
  @media (max-width: 880px) { .rev-grid { grid-template-columns: 1fr; max-width: 34rem; margin-inline: auto; } }
</style>
