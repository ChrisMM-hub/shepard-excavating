---
import { getImage } from 'astro:assets';
import heroImg from '../assets/photos/v3-hero-trucks.jpg';
import { business, homepage } from '../data/site';

// The original site's hero: the truck lineup, darkened, with centered text.
// Kept LCP-safe: resolved via getImage so we can preload it and decode synchronously
// (astro:assets defaults to decoding="async", which delays painting the hero).
const hero = await getImage({
  src: heroImg,
  widths: [540, 828, 1280, 1920],
  sizes: '100vw',
  format: 'webp',
  quality: 70,
});
---

{!homepage.hero.heroUpload && (
  <link rel="preload" as="image" href={hero.src} imagesrcset={hero.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
)}
<section class="hero" aria-label="Introduction">
  {homepage.hero.heroUpload ? (
    <img
      src={homepage.hero.heroUpload}
      alt="The Shepard Excavating truck fleet lined up in front of the shop in Laporte, Minnesota"
      class="hero-bg"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  ) : (
    <img
      src={hero.src}
      srcset={hero.srcSet.attribute}
      sizes="100vw"
      alt="The Shepard Excavating truck fleet lined up in front of the shop in Laporte, Minnesota"
      class="hero-bg"
      width="1920"
      height="830"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  )}
  <div class="hero-overlay"></div>

  <div class="container hero-inner">
    <h1>{homepage.hero.title.split('\n').map((line, i) => (
      <Fragment>{i > 0 && <br />}{line}</Fragment>
    ))}</h1>
    <a href={business.phoneHref} class="hero-pill">{homepage.hero.phonePill}</a>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; min-height: clamp(300px, 42vh, 440px); display: flex; align-items: center; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero-overlay { position: absolute; inset: 0; z-index: -1; background: rgba(0, 0, 0, 0.5); }
  .hero-inner { text-align: center; color: #fff; padding-block: clamp(2.5rem, 6vw, 4rem); }
  .hero h1 { color: #fff; font-size: clamp(1.7rem, 4.2vw, 2.7rem); text-shadow: 0 2px 14px rgba(0,0,0,0.45); }
  .hero-pill {
    display: inline-block; margin-top: 1.4rem;
    background: #fff; color: var(--ink);
    font-family: var(--font-body); font-weight: 700; font-size: 0.98rem;
    padding: 0.8rem 1.4rem; border-radius: var(--r); box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hero-pill:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
</style>
