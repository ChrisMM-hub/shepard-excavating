---
import { getImage } from 'astro:assets';
import heroImg from '../assets/photos/hero.jpg';
import { business } from '../data/site';

// Resolve the hero (LCP) image up front so we can preload it and force a
// synchronous decode. astro:assets defaults to decoding="async", which lets the
// browser defer painting the already-downloaded hero and inflates LCP.
const hero = await getImage({
  src: heroImg,
  widths: [540, 828, 1280, 1920],
  sizes: '100vw',
  format: 'webp',
  quality: 68,
});
---

<link rel="preload" as="image" href={hero.src} imagesrcset={hero.srcSet.attribute} imagesizes="100vw" fetchpriority="high" />
<section class="hero" aria-label="Introduction">
  <img
    src={hero.src}
    srcset={hero.srcSet.attribute}
    sizes="100vw"
    alt="A Shepard Excavating dump truck being loaded by a wheel loader at a Northern Minnesota gravel pit"
    class="hero-bg"
    width="1208"
    height="906"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <div class="hero-overlay"></div>

  <div class="container hero-inner">
    <p class="eyebrow eyebrow--light">Family-owned since {business.founded} · Laporte, MN</p>
    <h1>Septic, Excavating &amp; Site Work<br />in the <span class="hl">Bemidji &amp; Leech Lake Area</span></h1>
    <p class="hero-sub">
      Septic systems to snow removal, one local crew, one call. Family-owned since {business.founded}.
    </p>
    <div class="hero-cta">
      <a href="#contact" class="btn btn-primary btn-lg">Get a Free Estimate</a>
      <a href={business.phoneHref} class="btn btn-outline btn-lg">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
        {business.phone}
      </a>
    </div>
    <ul class="hero-trust">
      <li>MPCA-Certified Installer</li>
      <li>Licensed &amp; Insured</li>
      <li>Emergency Service Available</li>
    </ul>
  </div>
</section>

<style>
  /* Anchor content to the top (not center) so a font-swap text-height change cannot
     re-center and shift the whole hero block. Fixes mobile CLS. */
  .hero { position: relative; isolation: isolate; min-height: clamp(560px, 82vh, 820px); display: flex; align-items: flex-start; }
  .hero-inner { margin-top: clamp(1.5rem, 7vh, 5rem); }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero-overlay {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(20,18,16,0.55) 0%, rgba(20,18,16,0.15) 30%, rgba(20,18,16,0.35) 65%, rgba(20,18,16,0.85) 100%),
      linear-gradient(90deg, rgba(20,18,16,0.78) 0%, rgba(20,18,16,0.25) 55%, rgba(20,18,16,0) 100%);
  }
  .hero-inner { padding-block: clamp(2.5rem, 6vw, 4rem); color: #fff; }
  .eyebrow--light { color: var(--yellow); }
  .eyebrow--light::before { background: var(--yellow); }
  .hero h1 { color: #fff; margin: 0.7rem 0 0; font-size: clamp(2.4rem, 5.4vw, 4rem); text-shadow: 0 2px 24px rgba(0,0,0,0.35); max-width: 22ch; }
  .hl { color: var(--yellow); }
  .hero-sub { max-width: 46ch; margin-top: 1.2rem; font-size: clamp(1.08rem, 1.5vw, 1.32rem); color: #ece9e2; line-height: 1.55; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 1.8rem; }
  .hero-trust {
    display: flex; flex-wrap: wrap; gap: 1.4rem; margin-top: 1.9rem;
    font-family: var(--font-head); font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; font-size: 0.84rem; color: #fff;
  }
  .hero-trust li { display: flex; align-items: center; gap: 0.5rem; }
  .hero-trust li::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--grad); }
  @media (max-width: 640px) {
    .hero { min-height: 86vh; }
    .hero-trust { gap: 0.8rem 1.2rem; font-size: 0.76rem; }
  }
</style>
