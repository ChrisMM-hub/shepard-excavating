---
import { Image } from 'astro:assets';
import whyImg from '../assets/photos/whyus-fleet.jpg';
import { whyUs, business } from '../data/site';
---

<section class="section" id="why" aria-labelledby="why-h">
  <div class="container why-grid">
    <div class="why-media">
      <Image src={whyImg} alt="The Shepard Excavating dump truck fleet parked at the shop" widths={[600, 1100]} sizes="(max-width: 900px) 100vw, 540px" quality={78} />
      <div class="tag-pull">
        <p>{business.tagline}</p>
        <span class="tag-sub">Est. {business.founded}</span>
      </div>
    </div>

    <div class="why-content">
      <p class="eyebrow">Why Shepard</p>
      <h2 id="why-h">Why folks around here call Shepard first</h2>
      <ul class="why-list">
        {whyUs.map((w, i) => (
          <li>
            <span class="why-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="why-cta">
        <a href="#contact" class="btn btn-primary">Get a Free Estimate</a>
        <a href={business.phoneHref} class="btn btn-ghost">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
          {business.phone}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .why-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: stretch; }
  .why-media { position: relative; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow); min-height: 100%; }
  .why-media :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tag-pull {
    position: absolute; left: 1rem; bottom: 1rem; right: 1rem;
    background: rgba(20,18,16,0.9); color: #fff; border-left: 5px solid var(--yellow);
    padding: 0.9rem 1.2rem; border-radius: var(--r); backdrop-filter: blur(3px);
  }
  .tag-pull p { font-family: var(--font-head); font-weight: 800; text-transform: uppercase; font-size: clamp(1.1rem, 1.9vw, 1.45rem); line-height: 1.05; }
  .tag-sub { display: inline-block; margin-top: 0.3rem; font-family: var(--font-head); font-weight: 700; letter-spacing: 0.08em; font-size: 0.74rem; color: var(--gold); text-transform: uppercase; }

  .why-content { padding-block: 0.5rem; }
  .why-list { display: grid; gap: 1.35rem; margin-top: 1.6rem; }
  .why-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .why-num { font-family: var(--font-head); font-weight: 800; font-size: 1.5rem; line-height: 1; color: transparent; background: var(--grad); -webkit-background-clip: text; background-clip: text; padding-top: 0.1rem; }
  .why-list h3 { font-size: 1.18rem; }
  .why-list p { color: var(--slate); margin-top: 0.2rem; }
  .why-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }

  @media (max-width: 900px) {
    .why-grid { grid-template-columns: 1fr; }
    .why-media { min-height: 340px; }
  }
</style>
