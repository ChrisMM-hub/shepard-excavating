---
import { Image } from 'astro:assets';
import whyImg from '../assets/photos/whyus.jpg';
import { whyUs, business } from '../data/site';
---

<section class="section" id="why" aria-labelledby="why-h">
  <div class="container why-grid">
    <div class="why-media">
      <Image src={whyImg} alt="Shepard Excavating crew and trucks on a job site" widths={[600, 1100]} sizes="(max-width: 900px) 100vw, 540px" quality={76} />
      <div class="tag-pull">
        <span class="tag-mark">“</span>
        <p>{business.tagline}</p>
        <span class="tag-sub">Est. {business.founded}</span>
      </div>
    </div>

    <div class="why-content">
      <p class="eyebrow">Why Shepard</p>
      <h2 id="why-h">Why folks around here call Shepard first</h2>
      <ul class="why-list">
        {whyUs.map((w, i) => (
          <li>
            <span class="why-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .why-grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .why-media { position: relative; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow); }
  .why-media :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 3; }
  .tag-pull {
    position: absolute; left: 1rem; bottom: 1rem; right: 1rem;
    background: rgba(20,18,16,0.88); color: #fff; border-left: 5px solid var(--yellow);
    padding: 1rem 1.2rem; border-radius: var(--r); backdrop-filter: blur(3px);
  }
  .tag-pull p { font-family: var(--font-head); font-weight: 800; text-transform: uppercase; font-size: clamp(1.1rem, 2vw, 1.5rem); line-height: 1.05; }
  .tag-mark { position: absolute; top: -0.2rem; left: 0.8rem; font-family: var(--font-head); font-size: 2.4rem; color: var(--yellow); opacity: 0.5; }
  .tag-sub { display: inline-block; margin-top: 0.4rem; font-family: var(--font-head); font-weight: 700; letter-spacing: 0.08em; font-size: 0.74rem; color: var(--gold); text-transform: uppercase; }

  .why-list { display: grid; gap: 1.4rem; margin-top: 1.6rem; }
  .why-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: start; }
  .why-num { font-family: var(--font-head); font-weight: 800; font-size: 1.5rem; line-height: 1; color: transparent; background: var(--grad); -webkit-background-clip: text; background-clip: text; padding-top: 0.15rem; }
  .why-list h3 { font-size: 1.18rem; }
  .why-list p { color: var(--slate); margin-top: 0.2rem; }
  @media (max-width: 900px) { .why-grid { grid-template-columns: 1fr; } }
</style>
