---
import { Image } from 'astro:assets';
import poster from '../assets/photos/svc-excavating.jpg';
import { video } from '../data/site';

const hasSource = Boolean(video.youtubeId || video.mp4);
---

<section class="section section--dark" id="video" aria-labelledby="video-h">
  <div class="container">
    <div class="section-head center">
      <p class="eyebrow" style="justify-content:center;">See us in action</p>
      <h2 id="video-h">Watch us move some dirt</h2>
      <p class="lead">A quick look at the iron, the people, and the kind of dirt work we do across Northern Minnesota.</p>
    </div>

    <div
      class={'vid ' + (hasSource ? 'is-live' : 'is-placeholder')}
      data-youtube={video.youtubeId}
      data-mp4={video.mp4}
    >
      <Image src={poster} class="vid-poster" alt="Shepard Excavating equipment working a job site" widths={[800, 1280, 1600]} sizes="(max-width: 1000px) 100vw, 960px" quality={78} />
      <div class="vid-overlay"></div>
      <button class="vid-play" aria-label={hasSource ? 'Play video' : 'Video coming soon'} disabled={!hasSource}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      </button>
      {!hasSource && <span class="vid-soon">Video coming soon</span>}
    </div>
  </div>
</section>

<style>
  .eyebrow { color: var(--yellow); }
  .eyebrow::before { background: var(--yellow); }

  .vid { position: relative; max-width: 960px; margin: 0 auto; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); background: #000; }
  .vid :global(img.vid-poster) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vid-overlay { position: absolute; inset: 0; background: radial-gradient(circle at center, rgba(20,18,16,0.2), rgba(20,18,16,0.62)); }

  .vid-play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 88px; height: 88px; border-radius: 50%; border: 0; background: var(--yellow); color: var(--ink);
    display: grid; place-items: center; box-shadow: 0 8px 30px rgba(0,0,0,0.45); transition: transform 0.15s ease, background 0.15s ease;
  }
  .vid-play svg { width: 38px; height: 38px; margin-left: 5px; }
  .vid.is-live .vid-play { cursor: pointer; }
  .vid.is-live .vid-play:hover { transform: translate(-50%, -50%) scale(1.07); background: var(--yellow-deep); }
  .vid.is-placeholder .vid-play { opacity: 0.9; cursor: default; }

  .vid-soon {
    position: absolute; bottom: 1.1rem; left: 50%; transform: translateX(-50%);
    background: rgba(20,18,16,0.82); color: #fff; font-family: var(--font-head); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.78rem; padding: 0.45rem 0.9rem; border-radius: 999px;
  }

  .vid.playing .vid-poster, .vid.playing .vid-overlay, .vid.playing .vid-play, .vid.playing .vid-soon { display: none; }
  .vid :global(.vid-frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll('.vid.is-live').forEach((vid) => {
    const el = vid as HTMLElement;
    const btn = el.querySelector('.vid-play');
    btn?.addEventListener('click', () => {
      const yt = el.dataset.youtube;
      const mp4 = el.dataset.mp4;
      let node: HTMLElement | null = null;
      if (yt) {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${yt}?autoplay=1&rel=0`;
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        f.setAttribute('allowfullscreen', '');
        f.title = 'Shepard Excavating video';
        node = f;
      } else if (mp4) {
        const v = document.createElement('video');
        v.src = mp4;
        v.controls = true;
        v.autoplay = true;
        (v as HTMLVideoElement).playsInline = true;
        node = v;
      }
      if (node) {
        node.className = 'vid-frame';
        el.appendChild(node);
        el.classList.add('playing');
      }
    });
  });
</script>
