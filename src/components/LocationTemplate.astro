---
import { Image } from 'astro:assets';
import QuoteForm from './QuoteForm.astro';
import { img } from '../lib/images';
import { business, featuredServices, moreServices } from '../data/site';
import type { Location } from '../data/locations';

interface Props { location: Location; }
const { location } = Astro.props;
const hero = img(location.heroImage);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(location.mapQuery)}&z=11&output=embed`;
const moreLinks = moreServices;
---

<!-- Hero -->
<section class="loc-hero" aria-label={location.name}>
  {location.heroUpload ? (
    <img src={location.heroUpload} alt={'Shepard Excavating working in ' + location.name + ', MN'} class="loc-hero-bg" loading="eager" fetchpriority="high" />
  ) : (
    <Image src={hero} alt={'Shepard Excavating working in ' + location.name + ', MN'} class="loc-hero-bg" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={76} />
  )}
  <div class="loc-hero-overlay"></div>
  <div class="container loc-hero-inner">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>{location.name}</span></nav>
    <p class="eyebrow eyebrow--light">{location.county}</p>
    <h1>{location.h1}</h1>
    <p class="loc-lead">{location.intro}</p>
    <div class="loc-cta">
      <a href="#quote" class="btn btn-primary btn-lg">Get a Free Estimate</a>
      <a href={business.phoneHref} class="btn btn-outline btn-lg">Call {business.phone}</a>
    </div>
  </div>
</section>

<!-- Services available here -->
<section class="section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What we do in {location.name}</p>
      <h2>One call covers the whole job</h2>
      <p class="lead">Septic, dirt work, materials, and snow, all from one local outfit. Here is what we handle around {location.name}.</p>
    </div>
    <div class="loc-svc-grid">
      {featuredServices.map((s) => (
        <a class="loc-svc-card" href={'/' + s.slug}>
          <Image src={img(s.img + '.jpg')} alt={s.title} widths={[300, 600]} sizes="260px" quality={70} />
          <span class="lc-label" set:html={s.title + '&nbsp;<span class="arr" aria-hidden="true">&rarr;</span>'} />
        </a>
      ))}
    </div>
    <ul class="loc-more">
      {moreLinks.map((s) => (<li><a href={'/' + s.slug}>{s.title}</a></li>))}
      <li><a href="/septic-education">Septic Education</a></li>
    </ul>
  </div>
</section>

<!-- Local + map -->
<section class="section section--stone">
  <div class="container loc-local">
    <div class="loc-local-text">
      <p class="eyebrow">Around {location.name}</p>
      <h2>We know this country</h2>
      <p>{location.local}</p>
      <p>Family-owned since {business.founded}, we are licensed, insured, and used to working the lakes and rural roads of Northern Minnesota. One call, and we will get you a fair, no-pressure estimate.</p>
      <div class="loc-nap">
        <a href={business.phoneHref} class="loc-phone">{business.phone}</a>
        <p>{business.address.street}, {business.address.city}, {business.address.region} {business.address.zip}<br />{business.hours}</p>
      </div>
    </div>
    <div class="loc-map">
      <iframe src={mapSrc} title={'Map of ' + location.name + ', Minnesota'} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<!-- FAQ -->
{location.faqs && location.faqs.length > 0 && (
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head center"><p class="eyebrow" style="justify-content:center;">Good questions</p><h2>{location.name} FAQs</h2></div>
      <div class="faq-list">
        {location.faqs.map((f) => (
          <details class="faq-item" name="loc-faq">
            <summary><span class="faq-q">{f.q}</span><span class="faq-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span></summary>
            <div class="faq-a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Quote CTA -->
<section class="section section--dark" id="quote" aria-labelledby="loc-quote-h">
  <div class="container contact-grid">
    <div class="contact-info">
      <p class="eyebrow">Get a free estimate</p>
      <h2 id="loc-quote-h">Got a project in {location.name}?</h2>
      <p class="lead">Tell us about the job. We will get you a straight answer and a fair price, no runaround.</p>
      <p class="contact-phone"><a href={business.phoneHref}>{business.phone}</a></p>
    </div>
    <QuoteForm location={location.name} />
  </div>
</section>

<style>
  .loc-hero { position: relative; isolation: isolate; display: flex; align-items: center; min-height: clamp(360px, 52vh, 520px); }
  .loc-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .loc-hero-overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(20,18,16,0.86) 0%, rgba(20,18,16,0.5) 60%, rgba(20,18,16,0.25) 100%), linear-gradient(0deg, rgba(20,18,16,0.7), rgba(20,18,16,0.2)); }
  .loc-hero-inner { color: #fff; padding-block: clamp(2rem, 5vw, 3.5rem); }
  .crumbs { display: flex; gap: 0.5rem; font-family: var(--font-head); font-weight: 600; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.04em; color: #cfccc2; margin-bottom: 0.8rem; }
  .crumbs a { color: var(--yellow); }
  .eyebrow--light { color: var(--yellow); }
  .eyebrow--light::before { background: var(--yellow); }
  .loc-hero h1 { color: #fff; font-size: clamp(1.9rem, 4vw, 3rem); margin: 0.5rem 0 0; max-width: 20ch; text-shadow: 0 2px 20px rgba(0,0,0,0.35); }
  .loc-lead { max-width: 56ch; margin-top: 1rem; font-size: clamp(1.05rem, 1.5vw, 1.25rem); color: #ece9e2; }
  .loc-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.6rem; }

  .loc-svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .loc-svc-card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; display: flex; flex-direction: column; transition: transform 0.16s, box-shadow 0.16s; }
  .loc-svc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .loc-svc-card :global(img) { width: 100%; height: 150px; object-fit: cover; }
  .loc-svc-card .lc-label { padding: 0.9rem 1rem; font-family: var(--font-head); font-weight: 700; color: var(--ink); }
  .loc-svc-card :global(.arr) { color: var(--red); }
  .loc-more { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; margin-top: 1.4rem; }
  .loc-more a { font-family: var(--font-head); font-weight: 700; color: var(--red); text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.9rem; }
  .loc-more a:hover { color: var(--ink); }

  .loc-local { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  .loc-local-text p { color: var(--slate); margin-top: 0.8rem; max-width: 60ch; }
  .loc-nap { margin-top: 1.4rem; }
  .loc-phone { font-family: var(--font-head); font-weight: 800; font-size: 1.6rem; color: var(--ink); }
  .loc-nap p { color: var(--slate); }
  .loc-map { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid var(--line); }
  .loc-map iframe { width: 100%; height: 100%; min-height: 360px; border: 0; display: block; }

  .contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact-phone { margin-top: 1.2rem; }
  .contact-phone a { font-family: var(--font-head); font-weight: 800; font-size: 1.8rem; color: var(--yellow); }

  .faq-list { max-width: 820px; margin: 0 auto; }
  .faq-item { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); margin-bottom: 0.85rem; overflow: hidden; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.2rem; padding: 1.1rem 1.35rem; }
  summary::-webkit-details-marker { display: none; }
  .faq-q { font-family: var(--font-head); font-weight: 700; font-size: 1.08rem; }
  .faq-ic { flex-shrink: 0; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: var(--stone); color: var(--ink); transition: transform 0.22s, background 0.16s; }
  .faq-ic svg { width: 18px; height: 18px; }
  .faq-item[open] .faq-ic { transform: rotate(180deg); background: var(--yellow); }
  .faq-a { padding: 0 1.35rem 1.25rem; }
  .faq-a p { color: var(--slate); max-width: 68ch; }

  @media (max-width: 900px) {
    .loc-local { grid-template-columns: 1fr; }
    .loc-map iframe { min-height: 300px; }
    .contact-grid { grid-template-columns: 1fr; }
  }
</style>
