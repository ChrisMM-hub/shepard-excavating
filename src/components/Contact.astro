---
import { business, featuredServices, moreServices, towns } from '../data/site';
const services = [...featuredServices, ...moreServices].map((s) => s.title);
---

<section class="section section--dark" id="contact" aria-labelledby="contact-h">
  <div class="container contact-grid">
    <div class="contact-info">
      <p class="eyebrow">Get a free estimate</p>
      <h2 id="contact-h">Tell us about the job</h2>
      <p class="lead">
        Fill out the form or call and talk to a real person. We will get you a straight answer and a fair price.
        No pressure, no runaround.
      </p>

      <ul class="info-list">
        <li>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
          </span>
          <div><span class="info-label">Call or text</span><a href={business.phoneHref}>{business.phone}</a></div>
        </li>
        <li>
          <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m3 6 9 7 9-7" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
          <div><span class="info-label">Email</span><a href={business.emailHref}>{business.email}</a></div>
        </li>
        <li>
          <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" fill="currentColor"/></svg></span>
          <div><span class="info-label">Shop</span>{business.address.street}, {business.address.city}, {business.address.region} {business.address.zip}</div>
        </li>
        <li>
          <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
          <div><span class="info-label">Hours</span>{business.hours}</div>
        </li>
      </ul>
    </div>

    <div class="form-card">
      <form id="quote-form" novalidate>
        <div class="row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="phone">Phone <span class="req">*</span></label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="row">
          <div class="field">
            <label for="service">Service needed</label>
            <select id="service" name="service">
              <option value="">Select a service</option>
              {services.map((s) => (<option value={s}>{s}</option>))}
              <option value="Something else">Something else</option>
            </select>
          </div>
          <div class="field">
            <label for="town">Town</label>
            <select id="town" name="town">
              <option value="">Select your town</option>
              {towns.map((t) => (<option value={t}>{t}</option>))}
              <option value="Other">Other / nearby</option>
            </select>
          </div>
        </div>
        <div class="field">
          <span class="label-as">How soon?</span>
          <div class="urgency">
            <label><input type="radio" name="urgency" value="Routine" checked /> <span>Routine</span></label>
            <label><input type="radio" name="urgency" value="This week" /> <span>This week</span></label>
            <label class="urg-emer"><input type="radio" name="urgency" value="Emergency" /> <span>Emergency</span></label>
          </div>
        </div>
        <div class="field">
          <label for="message">Brief description</label>
          <textarea id="message" name="message" rows="3" placeholder="Tell us a little about the job, the property, and timing."></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Request My Free Estimate</button>
        <p class="form-fine">We answer fast. Your info goes straight to the Shepard crew, never sold or shared.</p>
      </form>

      <div class="form-success" id="form-success" hidden>
        <div class="check" aria-hidden="true">✓</div>
        <h3>Thanks, we got it.</h3>
        <p>Your request is in. We will reach out shortly. Need us right now? Call <a href={business.phoneHref}>{business.phone}</a>.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .info-list { display: grid; gap: 1.1rem; margin-top: 1.8rem; }
  .info-list li { display: flex; align-items: center; gap: 0.9rem; }
  .ico { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--charcoal-2); border: 1px solid rgba(255,255,255,0.1); color: var(--yellow); }
  .ico svg { width: 22px; height: 22px; }
  .info-label { display: block; font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; color: var(--gold); }
  .info-list a { font-size: 1.12rem; font-weight: 600; }
  .info-list a:hover { color: var(--yellow); }
  .info-list div:not(.ico) { color: #ded9cf; }

  .form-card { background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: clamp(1.4rem, 3vw, 2rem); box-shadow: var(--shadow-lg); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field { margin-bottom: 1rem; }
  label, .label-as { display: block; font-family: var(--font-head); font-weight: 700; font-size: 0.92rem; margin-bottom: 0.35rem; }
  .req { color: var(--red); }
  input, select, textarea {
    width: 100%; font: inherit; font-size: 1rem; padding: 0.75rem 0.85rem;
    border: 1.5px solid var(--line); border-radius: var(--r); background: var(--paper); color: var(--ink);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--orange); box-shadow: 0 0 0 3px rgba(224,122,23,0.18); background: #fff; }
  textarea { resize: vertical; }
  .urgency { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .urgency label { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-body); font-weight: 600; font-size: 0.98rem; padding: 0.55rem 0.9rem; border: 1.5px solid var(--line); border-radius: var(--r); cursor: pointer; margin: 0; }
  .urgency input { width: auto; }
  .urgency label:has(input:checked) { border-color: var(--ink); background: var(--stone); }
  .urg-emer label, .urgency .urg-emer:has(input:checked) { border-color: var(--red); }
  .urgency .urg-emer:has(input:checked) { background: #fbeae8; color: var(--red-deep); }
  .form-fine { font-size: 0.84rem; color: var(--slate); margin-top: 0.8rem; text-align: center; }

  .form-success { text-align: center; padding: 2.5rem 1rem; }
  .form-success .check { width: 64px; height: 64px; margin: 0 auto 1rem; border-radius: 50%; background: var(--grad); color: var(--ink); font-size: 2rem; font-weight: 800; display: grid; place-items: center; }
  .form-success h3 { font-size: 1.5rem; }
  .form-success p { color: var(--slate); margin-top: 0.5rem; }
  .form-success a { color: var(--orange-deep); font-weight: 700; }

  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .row { grid-template-columns: 1fr; } }
</style>

<script>
  // Prototype only: validate lightly and show an inline success state.
  // Production: POST to the HighLevel webhook, then redirect to /thank-you for GA4.
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const phone = (form.querySelector('#phone') as HTMLInputElement)?.value.trim();
    const name = (form.querySelector('#name') as HTMLInputElement)?.value.trim();
    if (!name || !phone) {
      if (!name) (form.querySelector('#name') as HTMLInputElement)?.focus();
      else (form.querySelector('#phone') as HTMLInputElement)?.focus();
      return;
    }
    form.hidden = true;
    if (success) success.hidden = false;
    success?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
</script>
