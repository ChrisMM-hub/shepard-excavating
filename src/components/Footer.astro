---
import { Image } from 'astro:assets';
import logo from '../assets/logo-shepard.png';
import { business, featuredServices, moreServices } from '../data/site';
const year = 2026;
const services = [...featuredServices, ...moreServices];

// Towns with live location pages (keeps the local-SEO internal links).
const townLinks = [
  ['Bemidji', '/bemidji-mn'],
  ['Laporte', '/laporte-mn'],
  ['Park Rapids', '/park-rapids-mn'],
  ['Walker', '/walker-mn'],
  ['Cass Lake', '/cass-lake-mn'],
  ['Hackensack', '/hackensack-mn'],
  ['Longville', '/longville-mn'],
];

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `Shepard Excavating, ${business.address.street}, ${business.address.city}, ${business.address.region} ${business.address.zip}`
)}`;
---

<footer class="footer">
  <div class="container foot-inner">
    <!-- brand + contact facts, one anchored column -->
    <div class="foot-brand">
      <a href="/" aria-label={business.shortName + ' home'}>
        <Image src={logo} alt={business.name} width={240} height={104} quality={88} loading="lazy" />
      </a>
      <ul class="foot-facts">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" fill="currentColor"/></svg>
          <a href={mapsUrl} rel="noopener" target="_blank">{business.address.street}, {business.address.city}, {business.address.region} {business.address.zip}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg>
          <a href={business.phoneHref}>Phone: {business.phone}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="foot-hours">
            <span>Monday&ndash;Friday: <strong>7:00am&ndash;5:00pm</strong></span>
            <span>Saturday&ndash;Sunday: <strong>Closed</strong></span>
          </span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5h2.5V5.5H14c-2 0-3.5 1.6-3.5 3.6v1.9H8v3h2.5V21h3v-7h2.3l.5-3h-2.8V9.4c0-.5.4-.9.9-.9Z" fill="currentColor"/></svg>
          <a href={business.facebook} rel="noopener" target="_blank">Follow us on Facebook</a>
        </li>
      </ul>
    </div>

    <nav class="foot-links foot-services" aria-label="Services">
      <p class="fl-label">Services</p>
      <ul class="fl-two">
        {services.map((s) => (<li><a href={'/' + s.slug}>{s.title}</a></li>))}
      </ul>
    </nav>

    <nav class="foot-links" aria-label="Areas we serve">
      <p class="fl-label">Areas We Serve</p>
      <ul>
        {townLinks.map(([town, href]) => (<li><a href={href}>{town}, MN</a></li>))}
      </ul>
    </nav>

    <nav class="foot-links" aria-label="More pages">
      <p class="fl-label">Company</p>
      <ul>
        <li><a href="/material-calculator">Material Calculator</a></li>
        <li><a href="/about">About Shepard</a></li>
        <li><a href="/gallery">Project Gallery</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy-policy">Privacy Policy</a></li>
        <li><a href="/terms-of-service">Terms of Service</a></li>
      </ul>
    </nav>
  </div>

  <div class="foot-bottom">
    <div class="container">
      <p>Copyright &copy; {year} Shepard Excavating &amp; Septic Service. All rights reserved. &middot; <a href="/excavation-and-septic-contractor-laporte-minnesota" class="footer-credit" rel="noopener">Site by Minnesota Marketing</a></p>
    </div>
  </div>
</footer>

<style>
  .footer { background: #151515; color: #fff; border-top: 4px solid var(--yellow); }
  .foot-inner {
    display: grid;
    grid-template-columns: 290px minmax(320px, 1.5fr) minmax(150px, 0.75fr) minmax(150px, 0.75fr);
    gap: clamp(1.8rem, 3.5vw, 3rem); align-items: start;
    padding-block: clamp(3rem, 5vw, 4rem);
  }
  .foot-brand {
    padding: 1.25rem; border: 1px solid rgba(255,255,255,0.11);
    border-radius: var(--r-lg); background: rgba(255,255,255,0.035);
  }
  .foot-brand :global(img) { width: 210px; height: auto; }

  .foot-facts { display: grid; gap: 0.9rem; align-content: start; margin-top: 1.25rem; }
  .foot-facts li { display: flex; align-items: flex-start; gap: 0.65rem; font-size: 0.9rem; color: #d0d0d0; line-height: 1.5; }
  .foot-facts svg { width: 17px; height: 17px; flex-shrink: 0; margin-top: 0.2rem; color: var(--yellow); }
  .foot-facts a { transition: color 0.15s ease; }
  .foot-facts a:hover { color: var(--yellow); }
  .foot-hours { display: grid; gap: 0.15rem; }
  .foot-hours > span { white-space: nowrap; }
  .foot-hours strong { color: #fff; font-weight: 600; }

  .fl-label {
    position: relative; padding-bottom: 0.7rem; margin-bottom: 1rem;
    border-bottom: 2px solid var(--yellow); color: #fff;
    font-family: var(--font-head); font-weight: 700; font-size: 0.9rem;
    line-height: 1.2; text-transform: uppercase; letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .foot-links ul { display: grid; gap: 0.55rem; align-content: start; }
  .fl-two { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 1.6rem; }
  .foot-links a {
    display: inline-block; font-size: 0.92rem; color: #cfcfcf; line-height: 1.45;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .foot-links a:hover { color: var(--yellow); transform: translateX(2px); }

  .foot-bottom { background: #090909; color: #bdbdbd; border-top: 1px solid rgba(255,255,255,0.1); }
  .foot-bottom p { padding-block: 0.9rem; font-size: 0.82rem; text-align: center; }
  .footer-credit { color: inherit; opacity: 0.7; text-decoration: none; font-size: 0.9em; font-weight: 400; }
  .footer-credit:hover { opacity: 1; text-decoration: underline; }

  @media (max-width: 1180px) {
    .foot-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) {
    .foot-inner { grid-template-columns: 1fr; }
    .foot-brand { max-width: 420px; }
  }
  @media (max-width: 400px) {
    .fl-two { grid-template-columns: 1fr; }
    .foot-hours > span { white-space: normal; }
  }
</style>
