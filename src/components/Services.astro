---
import { Image } from 'astro:assets';
import septic from '../assets/photos/svc-septic-pumping.jpg';
import excavating from '../assets/photos/svc-excavating.jpg';
import aggregate from '../assets/photos/svc-aggregate.jpg';

// Tier 1: the three services we lead with, shown as large photo tiles.
const tier1 = [
  { title: 'Septic Pumping & Service', href: '/septic-pumping', img: septic,
    alt: 'Shepard Excavating septic pump truck on a job', blurb: 'Pumping, inspections, and repairs that keep your system healthy.' },
  { title: 'Excavating & Site Work', href: '/excavating', img: excavating,
    alt: 'Excavator and loader during site work', blurb: 'Basements, foundations, grading, and road building.' },
  { title: 'Sand, Gravel & Aggregate', href: '/aggregate', img: aggregate,
    alt: 'Loader and screened gravel at the Shepard pit', blurb: 'Driveway rock, fill, and washed sand, delivered or hauled.' },
];

// Tier 2: everything else, as a compact icon grid.
const tier2 = [
  { title: 'Septic System Installation', href: '/septic-system', icon: 'tank' },
  { title: 'Septic Emergency', href: '/septic-emergency', icon: 'alert' },
  { title: 'Land Clearing', href: '/land-clearing', icon: 'tree' },
  { title: 'Demolition', href: '/demolition', icon: 'hammer' },
  { title: 'Roll-Off Dumpsters', href: '/roll-off-boxes', icon: 'dumpster' },
  { title: 'Snow Removal', href: '/snow-removal', icon: 'snow' },
  { title: 'Fisher Snowplow Dealer', href: '/fisher-snowplows', icon: 'plow' },
  { title: 'Septic Education', href: '/septic-education', icon: 'info' },
];

const icons: Record<string, string> = {
  tank: '<rect x="3" y="8" width="18" height="9" rx="2"/><path d="M7 8V5.5M17 8V5.5"/>',
  alert: '<path d="M12 4 2.5 20h19L12 4Z"/><path d="M12 10.5v3.5"/><path d="M12 17.2v.2"/>',
  tree: '<path d="M12 3 6.5 11h3L5.5 17h13L14.5 11h3L12 3Z"/><path d="M12 17v4"/>',
  hammer: '<path d="M14.5 6.5 9 12l-5.5 5.5 2 2L11 14l5.5-5.5"/><path d="M12.5 4.5 19.5 11.5"/><path d="M17 3l4 4-2.5 2.5-4-4L17 3Z"/>',
  dumpster: '<path d="M3.5 9h17l-1.8 10H5.3L3.5 9Z"/><path d="M2.5 9h19M9 9V6h6v3"/>',
  snow: '<path d="M12 2.5v19M3.5 7l17 10M20.5 7l-17 10"/>',
  plow: '<path d="M4 18V8l5.5 5.5H17"/><path d="M3 18h15"/><circle cx="20" cy="18" r="1.6"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.5v.2"/>',
};
---

<section class="section" id="services" aria-labelledby="services-h">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">What we do</p>
      <h2 id="services-h">Septic &amp; excavating services across Northern Minnesota</h2>
      <p class="lead">One local crew for the whole job, from septic systems and dirt work to gravel, demolition, and snow.</p>
    </div>

    <!-- Tier 1: lead services as photo tiles -->
    <ul class="tier1">
      {tier1.map((s) => (
        <li>
          <a href={s.href} class="tile">
            <Image src={s.img} alt={s.alt} widths={[400, 760]} sizes="(max-width: 760px) 100vw, 380px" quality={72} />
            <div class="tile-cap">
              <h3>{s.title}</h3>
              <p>{s.blurb}</p>
              <span class="tile-more">See details <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- Tier 2: everything else as a compact icon grid -->
    <p class="t2-label">All from one call</p>
    <ul class="tier2">
      {tier2.map((s) => (
        <li>
          <a href={s.href}>
            <span class="t2-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={icons[s.icon]} /></svg></span>
            <span class="t2-title">{s.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Tier 1 photo tiles */
  .tier1 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .tile { position: relative; display: block; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); aspect-ratio: 4 / 3.4; transition: transform 0.18s ease, box-shadow 0.18s ease; }
  .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .tile :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .tile:hover :global(img) { transform: scale(1.06); }
  .tile-cap { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.2rem 1.3rem; color: #fff;
    background: linear-gradient(180deg, rgba(20,18,16,0) 30%, rgba(20,18,16,0.35) 55%, rgba(20,18,16,0.9) 100%); }
  .tile-cap h3 { color: #fff; font-size: 1.32rem; }
  .tile-cap p { color: #ece9e2; font-size: 0.96rem; line-height: 1.4; margin-top: 0.3rem; }
  .tile-more { display: inline-block; margin-top: 0.6rem; font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.82rem; color: var(--yellow); }
  .tile:hover .tile-more span { display: inline-block; transform: translateX(4px); transition: transform 0.18s; }

  /* Tier 2 icon grid */
  .t2-label { margin: 2rem 0 1rem; font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.82rem; color: var(--slate); }
  .tier2 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.9rem; }
  .tier2 a { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem; padding: 1.1rem 0.8rem; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); transition: transform 0.16s, border-color 0.16s, box-shadow 0.16s; height: 100%; }
  .tier2 a:hover { transform: translateY(-3px); border-color: #cfc8ba; box-shadow: var(--shadow); }
  .t2-ico { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; background: var(--stone); color: var(--orange-deep); }
  .t2-ico svg { width: 26px; height: 26px; }
  .t2-title { font-family: var(--font-head); font-weight: 700; font-size: 0.95rem; color: var(--ink); line-height: 1.25; }

  @media (max-width: 820px) {
    .tier1 { grid-template-columns: 1fr; gap: 0.9rem; }
    .tile { aspect-ratio: 16 / 9; }
    .tier2 { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 460px) {
    .tier2 { grid-template-columns: repeat(2, 1fr); }
  }
</style>
