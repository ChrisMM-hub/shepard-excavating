---
import { towns, counties, business } from '../data/site';
const mapSrc =
  'https://www.google.com/maps?q=Laporte,+MN+56461&z=9&output=embed';
---

<section class="section section--dark" id="service-area" aria-labelledby="area-h">
  <div class="container area-grid">
    <div class="area-content">
      <p class="eyebrow">Service area</p>
      <h2 id="area-h">Serving Bemidji &amp; the Leech Lake area</h2>
      <p class="lead">
        Based in Laporte and working across {counties.join(', ')} counties. If you are on a lake, a county road,
        or somewhere in between, chances are we have worked nearby.
      </p>
      <ul class="towns">
        {towns.map((t) => (
          <li><a href={'/' + t.toLowerCase().replace(/\s+/g, '-') + '-mn'}><span class="pin" aria-hidden="true">●</span>{t}, MN</a></li>
        ))}
      </ul>
      <p class="area-note">Counties: {counties.join(' · ')}</p>
    </div>

    <div class="area-map">
      <iframe
        src={mapSrc}
        title={'Map of the ' + business.shortName + ' service area around Laporte, Minnesota'}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .area-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 3.5rem); align-items: center; }
  .towns { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem 1rem; margin: 1.6rem 0 1.1rem; }
  .towns a {
    display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.9rem;
    background: var(--charcoal-2); border: 1px solid rgba(255,255,255,0.08); border-radius: var(--r);
    font-family: var(--font-head); font-weight: 600; font-size: 1.02rem; color: #fff;
    transition: border-color 0.16s, transform 0.16s, background 0.16s;
  }
  .towns a:hover { border-color: var(--yellow); transform: translateX(3px); background: #34362c; }
  .pin { color: var(--yellow); font-size: 0.7rem; }
  .area-note { font-family: var(--font-head); font-weight: 600; letter-spacing: 0.04em; color: var(--gold); text-transform: uppercase; font-size: 0.82rem; }
  .area-map { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-lg); border: 1px solid rgba(255,255,255,0.1); }
  .area-map iframe { width: 100%; height: 100%; min-height: 380px; border: 0; display: block; filter: saturate(0.95); }
  @media (max-width: 860px) { .area-grid { grid-template-columns: 1fr; } .area-map iframe { min-height: 300px; } }
  @media (max-width: 420px) { .towns { grid-template-columns: 1fr; } }
</style>
