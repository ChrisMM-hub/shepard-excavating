---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// One of the original homepage's photo/text sections (Helping you make room,
// Get quick emergency service, Fisher Snowplows). `flip` mirrors the columns.
interface Props {
  heading: string;
  paragraphs: string[];
  btnLabel: string;
  btnHref: string;
  img: ImageMetadata;
  alt: string;
  flip?: boolean;
  tint?: boolean; // subtle alt background
}
const { heading, paragraphs, btnLabel, btnHref, img, alt, flip = false, tint = false } = Astro.props;
---

<section class={'feature section' + (tint ? ' feature--tint' : '')}>
  <div class={'container feat-grid' + (flip ? ' flip' : '')}>
    <div class="feat-text">
      <h2>{heading}</h2>
      {paragraphs.map((p) => (<p>{p}</p>))}
      <a href={btnHref} class="btn btn-red">{btnLabel}</a>
    </div>
    <div class="feat-media">
      <Image src={img} alt={alt} widths={[480, 760, 1100]} sizes="(max-width: 880px) 100vw, 560px" quality={64} loading="lazy" />
    </div>
  </div>
</section>

<style>
  .feature { background: #fff; }
  .feature--tint { background: var(--paper); }
  .feat-grid {
    display: grid; grid-template-columns: 1fr 1.1fr;
    gap: clamp(1.8rem, 5vw, 4rem); align-items: center;
  }
  .feat-grid.flip .feat-text { order: 2; }
  .feat-grid.flip .feat-media { order: 1; }

  .feat-text h2 { margin-bottom: 1rem; }
  .feat-text p { color: var(--slate); margin-bottom: 0.9rem; max-width: 56ch; }
  .feat-text .btn { margin-top: 0.6rem; }

  .feat-media :global(img) {
    width: 100%; height: auto; border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm); aspect-ratio: 4 / 3; object-fit: cover;
  }

  @media (max-width: 880px) {
    .feat-grid, .feat-grid.flip { grid-template-columns: 1fr; }
    .feat-grid.flip .feat-text { order: 0; }
    .feat-grid.flip .feat-media { order: 0; }
    /* original site's mobile order: heading, photo, text, button */
    .feat-grid { display: flex; flex-direction: column; align-items: stretch; }
    .feat-text { display: contents; }
    .feat-text h2 { order: 1; }
    .feat-media { order: 2; }
    .feat-text p { order: 3; }
    .feat-text .btn { order: 4; align-self: flex-start; }
  }
</style>
