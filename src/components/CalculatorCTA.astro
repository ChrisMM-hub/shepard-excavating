---
// Homepage promo band for the Material Calculator tool.
---
<section class="calc-cta" aria-labelledby="calc-cta-h">
  <div class="container cta-inner">
    <div class="cta-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="2.5" width="16" height="19" rx="2.5" stroke="currentColor" stroke-width="1.8"/><rect x="7" y="5" width="10" height="3.5" rx="1" fill="currentColor"/><circle cx="8.5" cy="12" r="1.1" fill="currentColor"/><circle cx="12" cy="12" r="1.1" fill="currentColor"/><circle cx="15.5" cy="12" r="1.1" fill="currentColor"/><circle cx="8.5" cy="15.5" r="1.1" fill="currentColor"/><circle cx="12" cy="15.5" r="1.1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.1" fill="currentColor"/><circle cx="8.5" cy="18.8" r="1.1" fill="currentColor"/></svg>
    </div>
    <div class="cta-text">
      <p class="cta-eyebrow">Free tool</p>
      <h2 id="calc-cta-h">How much material will your project need?</h2>
      <p>Get a quick cubic-yard estimate for fill, gravel, sand, or topsoil before you order. No guesswork, no coming up short.</p>
    </div>
    <a href="/material-calculator" class="btn btn-dark btn-lg cta-btn">Open the Material Calculator</a>
  </div>
</section>

<style>
  .calc-cta { background: var(--grad); }
  .cta-inner { display: flex; align-items: center; gap: clamp(1.2rem, 3vw, 2.4rem); padding-block: clamp(2rem, 4vw, 2.8rem); }
  .cta-icon { flex-shrink: 0; width: 64px; height: 64px; display: grid; place-items: center; background: rgba(20,18,16,0.12); border-radius: var(--r-lg); color: var(--ink); }
  .cta-icon svg { width: 38px; height: 38px; }
  .cta-text { flex: 1; min-width: 0; }
  .cta-eyebrow { font-family: var(--font-head); font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.8rem; color: var(--ink); opacity: 0.7; }
  .cta-text h2 { color: var(--ink); font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0.2rem 0 0.4rem; }
  .cta-text p { color: var(--ink); max-width: 60ch; font-size: 1.05rem; }
  .cta-btn { flex-shrink: 0; }

  @media (max-width: 820px) {
    .cta-inner { flex-direction: column; align-items: flex-start; text-align: left; }
    .cta-btn { width: 100%; }
  }
</style>
