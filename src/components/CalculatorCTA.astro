---
// Homepage band for the Material Calculator tool, styled to the original site's
// plain aesthetic: light section, dark heading, crimson button.
import { homepage } from '../data/site';
---
<section class="calc-cta section--stone" aria-labelledby="calc-cta-h">
  <div class="container cta-inner">
    <div class="cta-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="2.5" width="16" height="19" rx="2.5" stroke="currentColor" stroke-width="1.8"/><rect x="7" y="5" width="10" height="3.5" rx="1" fill="currentColor"/><circle cx="8.5" cy="12" r="1.1" fill="currentColor"/><circle cx="12" cy="12" r="1.1" fill="currentColor"/><circle cx="15.5" cy="12" r="1.1" fill="currentColor"/><circle cx="8.5" cy="15.5" r="1.1" fill="currentColor"/><circle cx="12" cy="15.5" r="1.1" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.1" fill="currentColor"/><circle cx="8.5" cy="18.8" r="1.1" fill="currentColor"/></svg>
    </div>
    <div class="cta-text">
      <h2 id="calc-cta-h">{homepage.calculator.heading}</h2>
      <p>{homepage.calculator.body}</p>
    </div>
    <a href="/material-calculator" class="btn btn-red btn-lg cta-btn">Material Calculator</a>
  </div>
</section>

<style>
  .calc-cta { background: var(--stone); border-block: 1px solid var(--line); }
  .cta-inner { display: flex; align-items: center; gap: clamp(1.2rem, 3vw, 2.4rem); padding-block: clamp(2rem, 4vw, 2.6rem); }
  .cta-icon { flex-shrink: 0; width: 60px; height: 60px; display: grid; place-items: center; background: var(--yellow); border-radius: var(--r-lg); color: var(--ink); }
  .cta-icon svg { width: 36px; height: 36px; }
  .cta-text { flex: 1; min-width: 0; }
  .cta-text h2 { font-size: clamp(1.4rem, 2.6vw, 1.9rem); margin-bottom: 0.35rem; }
  .cta-text p { color: var(--slate); max-width: 62ch; font-size: 1rem; }
  .cta-btn { flex-shrink: 0; }

  @media (max-width: 820px) {
    .cta-inner { flex-direction: column; align-items: flex-start; }
    .cta-btn { width: 100%; }
  }
</style>
