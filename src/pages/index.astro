---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import CalculatorCTA from '../components/CalculatorCTA.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Gallery from '../components/Gallery.astro';
import MidCTA from '../components/MidCTA.astro';
import WhyUs from '../components/WhyUs.astro';
import MeetCrew from '../components/MeetCrew.astro';
import ServiceArea from '../components/ServiceArea.astro';
import FAQ from '../components/FAQ.astro';
import EmergencyBand from '../components/EmergencyBand.astro';
import Contact from '../components/Contact.astro';
import { faqs } from '../data/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base jsonLd={[faqSchema]}>
  <Hero />
  <TrustBar />
  <Intro />
  <Services />
  <Reviews />
  <CalculatorCTA />
  <BeforeAfter />
  <Gallery />
  <MidCTA />
  <WhyUs />
  <MeetCrew />
  <ServiceArea />
  <FAQ />
  <EmergencyBand />
  <Contact />
</Base>
