---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeFeature from '../components/HomeFeature.astro';
import CalculatorCTA from '../components/CalculatorCTA.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';

import pitImg from '../assets/photos/v3-pit.jpg';
import pumpTruckImg from '../assets/photos/v3-pump-truck.jpg';
import fisherImg from '../assets/photos/v3-fisher.jpg';

// v3 homepage: the original site's structure and copy, rebuilt on the fast stack.
// Kept from the v2 build: Material Calculator, all service + town pages (linked via
// nav, towns band, and footer), real Facebook reviews, HighLevel quote form.
// Copy for the hero, feature bands, and calculator banner is editable in TinaCMS
// (content/site/homepage.json); band order, photos, and links stay locked here.
import { homepage } from '../data/site';
const feat = Object.fromEntries(homepage.features.map((f) => [f.key, f]));
---

<Base>
  <Hero />

  <HomeFeature
    heading={feat.excavating.heading}
    paragraphs={feat.excavating.paragraphs.map((p) => p.text)}
    btnLabel={feat.excavating.btnLabel}
    btnHref="/excavating"
    img={pitImg}
    alt="Shepard Excavating equipment moving sand and screening material at the pit"
  />

  <HomeFeature
    heading={feat.septic.heading}
    paragraphs={feat.septic.paragraphs.map((p) => p.text)}
    btnLabel={feat.septic.btnLabel}
    btnHref="/septic-pumping"
    img={pumpTruckImg}
    alt="The Shepard Excavating septic pump truck P6 ready to roll in winter"
    flip
    tint
  />

  <HomeFeature
    heading={feat.fisher.heading}
    paragraphs={feat.fisher.paragraphs.map((p) => p.text)}
    btnLabel={feat.fisher.btnLabel}
    btnHref="/fisher-snowplows"
    img={fisherImg}
    alt="A Fisher XV2 V-plow mounted on a pickup at the Shepard Excavating shop"
  />

  <CalculatorCTA />
  <Reviews />
  <Contact />
</Base>
