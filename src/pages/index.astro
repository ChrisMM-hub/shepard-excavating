---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeFeature from '../components/HomeFeature.astro';
import CalculatorCTA from '../components/CalculatorCTA.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';

import pitImg from '../assets/photos/v3-pit.jpg';
import pumpTruckImg from '../assets/photos/v3-pump-truck.jpg';
import fisherImg from '../assets/photos/v3-fisher.jpg';

// v3 homepage: the original site's structure and copy, rebuilt on the fast stack.
// Kept from the v2 build: Material Calculator, all service + town pages (linked via
// nav, towns band, and footer), real Facebook reviews, HighLevel quote form.
---

<Base>
  <Hero />

  <HomeFeature
    heading="Helping you make room"
    paragraphs={[
      'We have the equipment and expertise to help with any and all of your excavation and demolition projects. From making room for your new dream home to driveway building we got you covered.',
      'Work with us and we will handle all of your land clearing done in a timely fashion.',
    ]}
    btnLabel="Excavating"
    btnHref="/excavating"
    img={pitImg}
    alt="Shepard Excavating equipment moving sand and screening material at the pit"
  />

  <HomeFeature
    heading="Get quick emergency service"
    paragraphs={[
      'When you need speedy, affordable emergency service, we are the only team you need.',
      'Let us help with septic emergencies, frozen pipes, snow removal, and more.',
    ]}
    btnLabel="Emergency"
    btnHref="/septic-emergency"
    img={pumpTruckImg}
    alt="The Shepard Excavating septic pump truck P6 ready to roll in winter"
    flip
    tint
  />

  <HomeFeature
    heading="Fisher Snowplows"
    paragraphs={[
      'Come check out our line up of Fisher snowplows for sale. We have a variety of snowplows on hand or can order anything you need.',
      "We can get v-plows or straight blades for 1/2 ton vehicles. Meaning we can set you up to push snow with just about anything! As well as ATV's! We also sell a variety of salters.",
      'We can order snow plows year round. So you are prepared before winter hits.',
    ]}
    btnLabel="Fisher Snowplows"
    btnHref="/fisher-snowplows"
    img={fisherImg}
    alt="A Fisher XV2 V-plow mounted on a pickup at the Shepard Excavating shop"
  />

  <CalculatorCTA />
  <Reviews />
  <Contact />
</Base>
