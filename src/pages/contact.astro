---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { business } from '../data/site';

const title = 'Contact Shepard Excavating | (218) 224-2754';
const description =
  'Call (218) 224-2754 for septic, excavating, gravel, and snow removal across Northern Minnesota. Family-owned in Laporte, MN since 1997.';
const mapSrc = 'https://www.google.com/maps?q=42554+County+45+Laporte+MN+56461&z=11&output=embed';
---

<Base title={title} description={description} ogImage="/og/contact.jpg">
  <section class="ct-hero">
    <div class="container">
      <p class="eyebrow eyebrow--light">Get in touch</p>
      <h1>Contact Shepard Excavating</h1>
      <p class="ct-lead">Call or send a message and you will get prompt, friendly service for septic, dirt work, gravel, snow removal, and more.</p>
    </div>
  </section>

  <section class="section">
    <div class="container ct-grid">
      <div class="ct-info">
        <ul class="info-list">
          <li>
            <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.58 3.6a1 1 0 0 1-.25 1l-2.2 2.2Z" fill="currentColor"/></svg></span>
            <div><span class="info-label">Call or text</span><a href={business.phoneHref}>{business.phone}</a></div>
          </li>
          <li>
            <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m3 6 9 7 9-7" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
            <div><span class="info-label">Email</span><a href={business.emailHref}>{business.email}</a></div>
          </li>
          <li>
            <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7Z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="9" r="2.5" fill="currentColor"/></svg></span>
            <div><span class="info-label">Shop</span>{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.zip}</div>
          </li>
          <li id="hours">
            <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2"/></svg></span>
            <div><span class="info-label">Hours</span>{business.hours}</div>
          </li>
        </ul>
        <a href={business.facebook} class="ct-fb" rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5h2.5V5.5H14c-2 0-3.5 1.6-3.5 3.6v1.9H8v3h2.5V21h3v-7h2.3l.5-3h-2.8V9.4c0-.5.4-.9.9-.9Z" fill="currentColor"/></svg>
          Follow us on Facebook
        </a>
      </div>
      <div class="ct-form">
        <h2>Send us a message</h2>
        <QuoteForm />
      </div>
    </div>
  </section>

  <section class="ct-map-wrap" aria-label="Service area map">
    <iframe src={mapSrc} title="Map of Shepard Excavating, Laporte, Minnesota" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </section>
</Base>

<style>
  .ct-hero { background: var(--charcoal); color: #fff; padding-block: clamp(2.5rem, 6vw, 4rem); }
  .eyebrow--light { color: var(--yellow); }
  .eyebrow--light::before { background: var(--yellow); }
  .ct-hero h1 { color: #fff; margin-top: 0.5rem; }
  .ct-lead { color: #cfccc2; margin-top: 0.8rem; max-width: 56ch; font-size: 1.12rem; }

  .ct-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .info-list { display: grid; gap: 1.1rem; }
  .info-list li { display: flex; align-items: center; gap: 0.9rem; }
  .ico { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--stone); border: 1px solid var(--line); color: var(--red); }
  .ico svg { width: 22px; height: 22px; }
  .info-label { display: block; font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.72rem; color: var(--slate); }
  .info-list a { font-size: 1.12rem; font-weight: 600; color: var(--ink); }
  .info-list a:hover { color: var(--red); }
  .ct-fb { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.6rem; font-family: var(--font-head); font-weight: 700; color: var(--ink); }
  .ct-fb svg { width: 22px; height: 22px; color: var(--red); }
  .ct-fb:hover { color: var(--red); }
  .ct-form h2 { margin-bottom: 1.1rem; }

  .ct-map-wrap { height: clamp(320px, 40vh, 460px); }
  .ct-map-wrap iframe { width: 100%; height: 100%; border: 0; display: block; }

  @media (max-width: 960px) { .ct-grid { grid-template-columns: 1fr; } }
</style>
