---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { business } from '../data/site';

// Pull every curated gallery image; category is the filename prefix.
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', { eager: true });

const labels: Record<string, string> = {
  excavating: 'Excavating & Site Work',
  septic: 'Septic',
  landclearing: 'Land Clearing',
  demolition: 'Demolition',
  aggregate: 'Sand & Gravel',
  snow: 'Snow & Fisher',
  fleet: 'Our Fleet',
};
const order = ['excavating', 'septic', 'landclearing', 'demolition', 'aggregate', 'snow', 'fleet'];

const items = Object.entries(modules)
  .map(([path, mod]) => {
    const file = path.split('/').pop() as string;
    const cat = file.replace(/-\d+\.jpg$/, '');
    return { cat, img: mod.default, file };
  })
  .sort((a, b) => order.indexOf(a.cat) - order.indexOf(b.cat) || a.file.localeCompare(b.file));

const cats = order.filter((c) => items.some((i) => i.cat === c));

const title = 'Project Gallery | Shepard Excavating & Septic Service';
const description =
  'Real excavating, septic, land clearing, demolition, gravel, and snow-removal projects by Shepard Excavating across the Bemidji and Leech Lake area.';
---

<Base title={title} description={description}>
  <section class="gal-hero">
    <div class="container">
      <p class="eyebrow eyebrow--light">Our work</p>
      <h1>Project Gallery</h1>
      <p class="gal-hero-sub">{items.length} jobs across {cats.length} kinds of work, all done in-house here in Northern Minnesota.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filters" role="tablist" aria-label="Filter projects by type">
        <button class="filter active" data-filter="all">All</button>
        {cats.map((c) => (<button class="filter" data-filter={c}>{labels[c]}</button>))}
      </div>

      <div class="gal-grid">
        {items.map((it, i) => (
          <figure class="gal-cell" data-cat={it.cat}>
            <Image src={it.img} alt={`${labels[it.cat]} project by Shepard Excavating (${i + 1})`} widths={[320, 640]} sizes="(max-width: 640px) 50vw, 320px" quality={72} />
            <figcaption>{labels[it.cat]}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark gal-cta">
    <div class="container center">
      <h2>Want work like this on your place?</h2>
      <p class="lead">Tell us about the job and we will get you a fair, no-pressure estimate.</p>
      <div class="gal-cta-row">
        <a href="/#contact" class="btn btn-primary btn-lg">Get a Free Estimate</a>
        <a href={business.phoneHref} class="btn btn-outline btn-lg">Call {business.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .gal-hero { background: var(--charcoal); color: #fff; padding-block: clamp(2.5rem, 6vw, 4rem); }
  .gal-hero h1 { color: #fff; font-size: clamp(2.4rem, 6vw, 4rem); margin-top: 0.5rem; }
  .eyebrow--light { color: var(--yellow); }
  .eyebrow--light::before { background: var(--yellow); }
  .gal-hero-sub { color: #cfccc2; font-size: 1.15rem; margin-top: 0.8rem; max-width: 50ch; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
  .filter {
    font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
    font-size: 0.86rem; padding: 0.55rem 1rem; border-radius: 999px; border: 1.5px solid var(--line);
    background: #fff; color: var(--ink); transition: all 0.15s;
  }
  .filter:hover { border-color: var(--ink); }
  .filter.active { background: var(--ink); color: var(--yellow); border-color: var(--ink); }

  .gal-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; }
  .gal-cell { position: relative; overflow: hidden; border-radius: var(--r-lg); aspect-ratio: 4 / 3; box-shadow: var(--shadow-sm); }
  .gal-cell :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.45s ease; }
  .gal-cell:hover :global(img) { transform: scale(1.07); }
  .gal-cell figcaption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 1.4rem 0.9rem 0.7rem;
    font-family: var(--font-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    font-size: 0.74rem; color: #fff; opacity: 0; transform: translateY(6px); transition: all 0.2s;
    background: linear-gradient(180deg, transparent, rgba(20,18,16,0.8));
  }
  .gal-cell:hover figcaption { opacity: 1; transform: translateY(0); }

  .gal-cta h2 { color: #fff; }
  .gal-cta-row { display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap; margin-top: 1.6rem; }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cells = document.querySelectorAll<HTMLElement>('.gal-cell');
  btns.forEach((b) =>
    b.addEventListener('click', () => {
      btns.forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      const f = b.dataset.filter;
      cells.forEach((c) => {
        c.style.display = f === 'all' || c.dataset.cat === f ? '' : 'none';
      });
    })
  );
</script>
