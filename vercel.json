{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:auto",
  "headers": [
    {
      "source": "/demo-homepage",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/demo-homepage/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "redirects": [
    { "source": "/emergency", "destination": "/septic-pumping", "permanent": true },
    { "source": "/septic-emergency", "destination": "/septic-pumping", "permanent": true },
    { "source": "/septic-pumping-maintenance", "destination": "/septic-pumping", "permanent": true },
    { "source": "/septic-system-education", "destination": "/septic-education", "permanent": true }
  ],
  "routes": [
    { "src": "^/roll-off-boxes/?$", "status": 410 }
  ]
}
